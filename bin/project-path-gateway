#!/bin/sh
# project-path-gateway 전역 프로그램
#
# 프로젝트 초기화 명령만 제공한다. 조회·검증은 프로젝트 안 라이브러리가 담당한다 (FR-083).
# 초기화는 루트 표식 파일, 디렉터리·파일 데이터 파일 두 개, 라이브러리, 에이전트 스킬을 만들거나 교체하고,
# 1.x 데이터 파일(project-path-gateway.conf)이 남아 있으면 읽거나 바꾸지 않고 안내만 한다 (기능 007).
#
#   project-path-gateway init [TARGET_DIR]
#   project-path-gateway --help | -h
#   project-path-gateway --version
#
# 구조: 도메인 → 애플리케이션 → 인프라 → 인터페이스 네 구획으로 나눈다 (plan.md 계층 대응).
# 도메인은 모델별 소제목(# --- 모델: ... ---)으로 나누고, 애플리케이션 구획 머리에 포트 목록(# 입력 포트:, # 출력 포트:)을 둔다.
# 이름 규칙: 인프라는 ppg__port_*(입력 포트)·ppg__infra_*(도우미)·ppg__sys_*(시스템 포트), 인터페이스는
# ppg__out_*(출력 포트 구현)·ppg__if_*(검사·결과 매핑). 출력 문구와 반환값은 인터페이스에서만 정한다(scripts/lint.sh 5절).
# 인프라 상태 변수(PPG_INFRA_)를 유지해야 하므로 함수는 서브셸 본문으로 정의하지 않는다.
# 애플리케이션 내부 코드: 0 성공, 10 사전 검사 실패, 11 라이브러리 원본 없음, 12 쓰기 실패.

PPG_VERSION=2.1.0

# === 계층: 도메인 ===

# --- 모델: 파일 내용과 처리 ---

# 파일 종류와 대상 상태(absent, file, other)로 처리(create, keep, replace, fail)를 정한다.
# 이미 있을 때의 결과는 배치 모델의 정책에서 온다 (기능 006 FR-017).
ppg__domain_plan_action() {
	case $2 in
	absent) printf 'create\n' ;;
	file) ppg__domain_layout_policy "$1" ;;
	*) printf 'fail\n' ;;
	esac
}

# 루트 표식 파일 내용 (contracts/files.md 2절).
ppg__domain_marker_content() {
	printf '%s\n' \
		'# project-path-gateway 루트 표식 파일입니다. 이 파일을 담은 .tools/ 디렉터리의 상위 디렉터리가 프로젝트 루트입니다.' \
		'format=1'
}

# 새 디렉터리 데이터 파일 내용: 설명 주석, 기본 경로 항목 두 개, 예시 주석 (기능 007 contracts/data-files.md 2절, 기능 006 FR-002·FR-005).
# 기본 항목의 두 경로는 init이 만들거나 확인하는 디렉터리이므로 초기화 직후 검증이 통과한다.
ppg__domain_dirs_template() {
	printf '%s\n' \
		'# project-path-gateway 디렉터리 데이터 파일' \
		'# 한 줄에 KEY=경로 형식으로 디렉터리를 적습니다. 경로는 프로젝트 루트(.tools/의 상위 디렉터리) 기준 상대경로입니다.' \
		'# 키: 대문자로 시작하고 대문자·숫자·_만 사용합니다. 파일 데이터 파일과 합쳐 중복될 수 없습니다.' \
		'# 경로: /로 시작할 수 없고 .. 세그먼트를 쓸 수 없습니다. 마지막 이름에 확장자가 있거나 .으로 시작하면 파일로 보므로 적을 수 없습니다.' \
		'# 빈 줄과 #으로 시작하는 줄은 무시합니다.' \
		'#' \
		'# 아래 두 항목은 초기화가 넣은 기본 항목입니다. 필요하지 않으면 지워도 됩니다.' \
		'PPG_TOOL_DIR=.tools/project-path-gateway' \
		'AGENT_SKILLS_DIR=.agents/skills' \
		'#' \
		'# 예:' \
		'# SOURCES_ROOT=sources' \
		'# WORKFLOWS_DIR=.github/workflows'
}

# 새 파일 데이터 파일 내용: 설명 주석과 예시 주석. 항목은 없다 (기능 007 contracts/data-files.md 2절).
ppg__domain_files_template() {
	printf '%s\n' \
		'# project-path-gateway 파일 데이터 파일' \
		'# 한 줄에 KEY=경로 형식으로 파일을 적습니다. 경로는 프로젝트 루트(.tools/의 상위 디렉터리) 기준 상대경로입니다.' \
		'# 키: 대문자로 시작하고 대문자·숫자·_만 사용합니다. 디렉터리 데이터 파일과 합쳐 중복될 수 없습니다.' \
		'# 경로: /로 시작할 수 없고 .. 세그먼트를 쓸 수 없습니다. 마지막 이름은 이름.확장자 모양이거나 .으로 시작해야 하며 /로 끝날 수 없습니다.' \
		'# 빈 줄과 #으로 시작하는 줄은 무시합니다.' \
		'#' \
		'# 예:' \
		'# BUILD_SCRIPT=scripts/build.sh' \
		'# ENV_FILE=.env'
}

# --- 모델: 도구 배치 (기능 005 research R-05, 기능 006 research R-02) ---

# 초기화가 다루는 디렉터리 목록(대상 디렉터리 기준 상대경로, 상위가 먼저).
ppg__domain_layout_dirs() {
	printf '%s\n' \
		'.tools' \
		'.tools/project-path-gateway' \
		'.agents' \
		'.agents/skills' \
		'.agents/skills/project-path-gateway'
}

# 디렉터리가 디렉터리가 아닐 때의 실패 코드.
ppg__domain_layout_dir_code() {
	case $1 in
	.tools) printf 'tool_not_dir\n' ;;
	.tools/project-path-gateway) printf 'tool_dir_not_dir\n' ;;
	*) printf 'dir_not_dir\n' ;;
	esac
}

# 초기화가 처리하는 파일 종류와 순서.
ppg__domain_layout_kinds() {
	printf 'marker dirs files library skill\n'
}

# 파일 종류별 경로(대상 디렉터리 기준 상대경로).
ppg__domain_layout_file_path() {
	case $1 in
	marker) printf '.tools/project-path-gateway/.project-path-gateway\n' ;;
	dirs) printf '.tools/project-path-gateway/project-path-gateway.dirs.conf\n' ;;
	files) printf '.tools/project-path-gateway/project-path-gateway.files.conf\n' ;;
	library) printf '.tools/project-path-gateway/project-path-gateway.sh\n' ;;
	skill) printf '.agents/skills/project-path-gateway/SKILL.md\n' ;;
	esac
}

# 파일이 이미 있을 때의 정책: keep(사용자 소유) 또는 replace(도구 소유).
ppg__domain_layout_policy() {
	case $1 in
	library | skill) printf 'replace\n' ;;
	*) printf 'keep\n' ;;
	esac
}

# 파일 내용의 출처: builtin(내장 내용 함수) 또는 installed(설치된 원본 파일).
ppg__domain_layout_content_source() {
	case $1 in
	library | skill) printf 'installed\n' ;;
	*) printf 'builtin\n' ;;
	esac
}

# 내장 내용을 내는 함수 이름(출처가 builtin인 종류).
ppg__domain_layout_content_func() {
	case $1 in
	marker) printf 'ppg__domain_marker_content\n' ;;
	dirs) printf 'ppg__domain_dirs_template\n' ;;
	files) printf 'ppg__domain_files_template\n' ;;
	esac
}

# 설치된 원본의 PREFIX 기준 상대경로(출처가 installed인 종류).
ppg__domain_layout_installed_source() {
	case $1 in
	library) printf 'share/project-path-gateway/project-path-gateway.sh\n' ;;
	skill) printf 'share/project-path-gateway/SKILL.md\n' ;;
	esac
}

# 설치된 원본을 찾지 못했을 때의 실패 코드.
ppg__domain_layout_missing_code() {
	case $1 in
	library) printf 'no_library\n' ;;
	skill) printf 'no_skill\n' ;;
	esac
}

# 1.x 데이터 파일 경로(대상 디렉터리 기준 상대경로). 초기화는 이 파일을 읽거나 바꾸지 않고 있으면 안내만 한다 (기능 007 contracts/cli-init.md 2절).
ppg__domain_layout_legacy_data_file() {
	printf '.tools/project-path-gateway/project-path-gateway.conf\n'
}

# 이번 실행의 임시 파일을 정리할 디렉터리 목록(대상 디렉터리 기준 상대경로).
ppg__domain_layout_temp_dirs() {
	printf '%s\n' \
		'.tools/project-path-gateway' \
		'.agents/skills/project-path-gateway'
}

# --- 기타 규칙 ---

# 디렉터리와 이름을 결합한다. 디렉터리가 /이면 슬래시를 중복하지 않는다.
ppg__domain_join() {
	printf '%s/%s\n' "${1%/}" "$2"
}

# === 계층: 애플리케이션 ===

# 입력 포트: ppg__port_dir_state ppg__port_file_state ppg__port_physical_dir ppg__port_installed_source
# 입력 포트: ppg__port_ensure_dirs ppg__port_failed_dir ppg__port_rollback_dirs ppg__port_write_new ppg__port_copy_new
# 입력 포트: ppg__port_replace ppg__port_cleanup_temp ppg__port_on_signal
# 출력 포트: ppg__out_action ppg__out_done ppg__out_failure ppg__out_legacy_notice

# 프로젝트 초기화 흐름 (contracts/cli.md 2절, 기능 006 research R-05, 기능 007 contracts/cli-init.md).
# 배치 모델의 디렉터리 목록·파일 목록을 순회할 뿐 경로·이름·정책 문자열을 갖지 않는다.
ppg__app_init_project() {
	target=$1
	if [ "$(ppg__port_dir_state "$target")" != dir ]; then
		ppg__out_failure not_dir "$target"
		return 10
	fi
	for rel in $(ppg__domain_layout_dirs); do
		dir=$(ppg__domain_join "$target" "$rel")
		if [ "$(ppg__port_dir_state "$dir")" = other ]; then
			ppg__out_failure "$(ppg__domain_layout_dir_code "$rel")" "$dir"
			return 10
		fi
	done
	for kind in $(ppg__domain_layout_kinds); do
		path=$(ppg__domain_join "$target" "$(ppg__domain_layout_file_path "$kind")")
		if [ "$(ppg__domain_plan_action "$kind" "$(ppg__port_file_state "$path")")" = fail ]; then
			ppg__out_failure not_regular "$path"
			return 10
		fi
	done
	for kind in $(ppg__domain_layout_kinds); do
		if [ "$(ppg__domain_layout_content_source "$kind")" != installed ]; then
			continue
		fi
		if ! source=$(ppg__port_installed_source "$(ppg__domain_layout_installed_source "$kind")"); then
			ppg__out_failure "$(ppg__domain_layout_missing_code "$kind")" "${source%x}"
			return 11
		fi
	done
	if ! target_physical=$(ppg__port_physical_dir "$target"); then
		ppg__out_failure not_dir "$target"
		return 10
	fi
	target_physical=${target_physical%x}

	if ! ppg__port_ensure_dirs "$target"; then
		ppg__out_failure write "$(ppg__port_failed_dir)"
		ppg__app_cleanup "$target"
		ppg__port_rollback_dirs
		return 12
	fi
	for kind in $(ppg__domain_layout_kinds); do
		relpath=$(ppg__domain_layout_file_path "$kind")
		path=$(ppg__domain_join "$target" "$relpath")
		action=$(ppg__domain_plan_action "$kind" "$(ppg__port_file_state "$path")")
		written=0
		case $(ppg__domain_layout_content_source "$kind"):$action in
		*:keep) written=1 ;;
		builtin:create) ppg__port_write_new "$path" "$(ppg__domain_layout_content_func "$kind")" && written=1 ;;
		installed:create | installed:replace)
			source=$(ppg__port_installed_source "$(ppg__domain_layout_installed_source "$kind")")
			source=${source%x}
			if [ "$action" = create ]; then
				ppg__port_copy_new "$path" "$source" && written=1
			else
				ppg__port_replace "$path" "$source" && written=1
			fi
			;;
		esac
		if [ "$written" -ne 1 ]; then
			ppg__out_failure write "$path"
			ppg__app_cleanup "$target"
			ppg__port_rollback_dirs
			return 12
		fi
		ppg__out_action "$action" "$relpath"
	done
	ppg__out_done "$target_physical"
	legacy=$(ppg__domain_layout_legacy_data_file)
	if [ "$(ppg__port_file_state "$(ppg__domain_join "$target" "$legacy")")" = file ]; then
		ppg__out_legacy_notice "$legacy"
	fi
	return 0
}

# 종료·중단 신호에 정리 동작을 건다. 동작 문자열(반환값 포함)은 인터페이스가 정한다.
ppg__app_arm_cleanup() {
	ppg__port_on_signal "$1" "$2"
}

# 이번 실행의 임시 파일을 지운다. 종료·신호 trap과 쓰기 실패 처리에서 호출한다.
ppg__app_cleanup() {
	for rel in $(ppg__domain_layout_temp_dirs); do
		ppg__port_cleanup_temp "$(ppg__domain_join "$1" "$rel")"
	done
}

# === 계층: 인프라 ===

# 시스템 포트(ppg__sys_*)만 파일 시스템·프로세스 환경에 접근한다. 본문은 명령 하나이며 다른 내부 함수를 호출하지 않는다.
# 변경 시스템 포트는 파이프라인이나 명령 치환 안에서 호출하지 않는다.

# 디렉터리 상태: absent, dir, other
ppg__port_dir_state() {
	if ppg__sys_is_dir "$1"; then
		printf 'dir\n'
	elif ppg__sys_exists "$1" || ppg__sys_is_link "$1"; then
		printf 'other\n'
	else
		printf 'absent\n'
	fi
}

# 파일 상태: absent, file, other
ppg__port_file_state() {
	if ppg__sys_is_file "$1"; then
		printf 'file\n'
	elif ppg__sys_exists "$1" || ppg__sys_is_link "$1"; then
		printf 'other\n'
	else
		printf 'absent\n'
	fi
}

# 디렉터리의 물리 경로를 끝 표지 방식으로 출력한다.
ppg__port_physical_dir() {
	ppg__sys_physical_dir "$1"
}

# 실행 파일($0)의 심볼릭 링크를 해소한 실제 디렉터리를 끝 표지 방식으로 출력한다 (research R-09). 인프라 도우미.
ppg__infra_self_dir() {
	ppg_infra_self=$(ppg__sys_self_path) || return 1
	ppg_infra_self=${ppg_infra_self%x}
	case $ppg_infra_self in
	*/*) ;;
	*)
		ppg_infra_self=$(ppg__sys_command_path "$ppg_infra_self") || return 1
		ppg_infra_self=${ppg_infra_self%x}
		;;
	esac
	ppg_infra_count=0
	while ppg__sys_is_link "$ppg_infra_self"; do
		ppg_infra_count=$((ppg_infra_count + 1))
		[ "$ppg_infra_count" -le 40 ] || return 1
		ppg_infra_link_dir=$(ppg__sys_physical_dir "${ppg_infra_self%/*}") || return 1
		ppg_infra_link_dir=${ppg_infra_link_dir%x}
		ppg_infra_target=$(ppg__sys_readlink "$ppg_infra_self") || return 1
		ppg_infra_target=${ppg_infra_target%x}
		case $ppg_infra_target in
		/*) ppg_infra_self=$ppg_infra_target ;;
		*) ppg_infra_self=${ppg_infra_link_dir%/}/$ppg_infra_target ;;
		esac
	done
	case $ppg_infra_self in
	*/*) ppg__sys_physical_dir "${ppg_infra_self%/*}" ;;
	*) ppg__sys_physical_dir . ;;
	esac
}

# 설치된 라이브러리 원본 경로를 끝 표지 방식으로 출력한다. 읽을 수 없으면 경로를 출력하고 반환 1.
# 인자: PREFIX 기준 설치 라이브러리 상대경로. 실행 파일은 PREFIX/bin에 있다.
ppg__port_installed_source() {
	ppg_infra_self_dir=$(ppg__infra_self_dir) || {
		ppg__sys_self_path
		return 1
	}
	ppg_infra_source=${ppg_infra_self_dir%x}/../$1
	printf '%sx' "$ppg_infra_source"
	ppg__sys_is_file "$ppg_infra_source" && ppg__sys_is_readable "$ppg_infra_source"
}

# 대상 디렉터리($1) 아래 배치 모델의 디렉터리 목록에서 없는 것만 순서대로 만들고, 이번 실행에서 만든 것을
# PPG_INFRA_CREATED_DIRS에 만든 순서의 역순으로(맨 앞에 붙여) LF로 이어 기록한다 (기능 006 research R-03).
ppg__port_ensure_dirs() {
	PPG_INFRA_CREATED_DIRS=''
	for ppg_infra_rel in $(ppg__domain_layout_dirs); do
		ppg_infra_dir=$(ppg__domain_join "$1" "$ppg_infra_rel")
		if ! ppg__sys_is_dir "$ppg_infra_dir"; then
			if ! ppg__sys_mkdir "$ppg_infra_dir"; then
				PPG_INFRA_FAILED_DIR=$ppg_infra_dir
				return 1
			fi
			PPG_INFRA_CREATED_DIRS="$ppg_infra_dir
$PPG_INFRA_CREATED_DIRS"
		fi
	done
	return 0
}

# ppg__port_ensure_dirs가 만들지 못한 디렉터리 경로. 실패 보고에 쓴다(상태 변수를 구획 밖에 노출하지 않기 위한 포트).
ppg__port_failed_dir() {
	printf '%s\n' "${PPG_INFRA_FAILED_DIR-}"
}

# 이번 실행에서 만든 디렉터리만 안쪽부터 되돌린다. 기록이 역순이므로 앞에서부터 꺼낸다.
# 비어 있지 않은 디렉터리는 rmdir가 실패하고 그 실패는 무시한다.
ppg__port_rollback_dirs() {
	ppg_infra_lf='
'
	ppg_infra_rest=${PPG_INFRA_CREATED_DIRS-}
	while [ -n "$ppg_infra_rest" ]; do
		ppg_infra_dir=${ppg_infra_rest%%"$ppg_infra_lf"*}
		ppg_infra_rest=${ppg_infra_rest#*"$ppg_infra_lf"}
		if [ -n "$ppg_infra_dir" ]; then
			ppg__sys_rmdir "$ppg_infra_dir"
		fi
	done
	return 0
}

# 대상과 같은 디렉터리의 임시 파일 경로: <디렉터리>/.ppg-tmp.<PID>.<대상 파일 이름>
ppg__infra_temp_path() {
	ppg_infra_pid=$(ppg__sys_pid)
	printf '%s/.ppg-tmp.%s.%s\n' "${1%/*}" "$ppg_infra_pid" "${1##*/}"
}

# CONTENT_FUNC 출력을 임시 파일에 쓰고 ln으로 새 파일을 연결한다. 대상이 이미 있으면 실패한다.
ppg__port_write_new() {
	ppg_infra_temp=$(ppg__infra_temp_path "$1")
	ppg_infra_content=$("$2" && printf x) || return 1
	ppg_infra_content=${ppg_infra_content%x}
	if ! ppg__sys_write_text "$ppg_infra_temp" "$ppg_infra_content"; then
		ppg__sys_remove "$ppg_infra_temp"
		return 1
	fi
	ppg__infra_link_temp "$ppg_infra_temp" "$1"
}

# 원본 파일을 임시 파일에 복사하고 ln으로 새 파일을 연결한다.
ppg__port_copy_new() {
	ppg_infra_temp=$(ppg__infra_temp_path "$1")
	if ! ppg__sys_copy_to "$2" "$ppg_infra_temp"; then
		ppg__sys_remove "$ppg_infra_temp"
		return 1
	fi
	ppg__infra_link_temp "$ppg_infra_temp" "$1"
}

ppg__infra_link_temp() {
	if ppg__sys_link "$1" "$2"; then
		ppg__sys_remove "$1"
		return 0
	fi
	ppg__sys_remove "$1"
	return 1
}

# 원본 파일을 임시 파일에 복사한 뒤 mv -f로 기존 파일을 교체한다.
ppg__port_replace() {
	ppg_infra_temp=$(ppg__infra_temp_path "$1")
	ppg__sys_copy_to "$2" "$ppg_infra_temp" &&
		ppg__sys_move "$ppg_infra_temp" "$1" && return 0
	ppg__sys_remove "$ppg_infra_temp"
	return 1
}

# 도구 디렉터리에서 이번 실행(PID)의 임시 파일만 지운다. 이름 목록을 받아 현재 셸에서 하나씩 지운다.
ppg__port_cleanup_temp() {
	PPG_INFRA_NL='
'
	ppg_infra_pid=$(ppg__sys_pid)
	ppg_infra_rest=$(ppg__sys_list_prefix "$1" ".ppg-tmp.$ppg_infra_pid.")
	while [ -n "$ppg_infra_rest" ]; do
		ppg_infra_name=${ppg_infra_rest%%"$PPG_INFRA_NL"*}
		case $ppg_infra_rest in
		*"$PPG_INFRA_NL"*) ppg_infra_rest=${ppg_infra_rest#*"$PPG_INFRA_NL"} ;;
		*) ppg_infra_rest= ;;
		esac
		ppg__sys_remove "$1/$ppg_infra_name"
	done
	return 0
}

# 종료·중단 신호에 동작 문자열을 건다.
ppg__port_on_signal() {
	ppg__sys_trap "$1" "$2"
}

# 시스템 포트: 디렉터리이면 반환 0 (링크를 따라간다).
ppg__sys_is_dir() {
	[ -d "$1" ]
}

# 시스템 포트: 일반 파일이면 반환 0 (링크를 따라간다).
ppg__sys_is_file() {
	[ -f "$1" ]
}

# 시스템 포트: 읽을 수 있으면 반환 0.
ppg__sys_is_readable() {
	[ -r "$1" ]
}

# 시스템 포트: 존재하면 반환 0 (링크를 따라간다).
ppg__sys_exists() {
	[ -e "$1" ]
}

# 시스템 포트: 심볼릭 링크이면 반환 0 (따라가지 않는다).
ppg__sys_is_link() {
	[ -L "$1" ]
}

# 시스템 포트: 디렉터리의 물리 경로를 끝 표지 방식으로 출력한다.
ppg__sys_physical_dir() {
	ppg_sys_dir=$(cd -P -- "$1" 2>/dev/null && pwd -P && printf x) || return 1
	ppg_sys_dir=${ppg_sys_dir%x}
	printf '%sx' "${ppg_sys_dir%?}"
}

# 시스템 포트: 심볼릭 링크 대상 문자열을 끝 표지 방식으로 출력한다.
ppg__sys_readlink() {
	ppg_sys_target=$(readlink -- "$1" && printf x) || return 1
	ppg_sys_target=${ppg_sys_target%x}
	printf '%sx' "${ppg_sys_target%?}"
}

# 시스템 포트: 실행 파일 이름($0)을 끝 표지 방식으로 출력한다.
ppg__sys_self_path() {
	printf '%sx' "$0"
}

# 시스템 포트: PATH에서 찾은 명령 경로를 끝 표지 방식으로 출력한다.
ppg__sys_command_path() {
	ppg_sys_path=$(command -v -- "$1") || return 1
	printf '%sx' "$ppg_sys_path"
}

# 시스템 포트: 현재 셸 PID를 출력한다.
ppg__sys_pid() {
	printf '%s\n' "$$"
}

# 시스템 포트: 디렉터리 바로 아래에서 이름이 접두어로 시작하는 항목 이름을 한 줄씩 출력한다.
ppg__sys_list_prefix() {
	for ppg_sys_entry in "$1"/"$2"*; do
		if [ -e "$ppg_sys_entry" ] || [ -L "$ppg_sys_entry" ]; then
			printf '%s\n' "${ppg_sys_entry##*/}"
		fi
	done
}

# 시스템 포트: 디렉터리 하나를 만든다.
ppg__sys_mkdir() {
	mkdir -- "$1" 2>/dev/null
}

# 시스템 포트: 빈 디렉터리를 지운다.
ppg__sys_rmdir() {
	rmdir -- "$1" 2>/dev/null
}

# 시스템 포트: 파일을 지운다. 없어도 성공이다.
ppg__sys_remove() {
	rm -f -- "$1" 2>/dev/null
}

# 시스템 포트: 문자열을 파일에 그대로 쓴다.
ppg__sys_write_text() {
	{ printf '%s' "$2" >"$1"; } 2>/dev/null
}

# 시스템 포트: 원본 파일 내용을 대상 파일에 쓴다.
ppg__sys_copy_to() {
	{ cat -- "$1" >"$2"; } 2>/dev/null
}

# 시스템 포트: 하드 링크를 만든다. 대상이 있으면 실패한다.
ppg__sys_link() {
	ln -- "$1" "$2" 2>/dev/null
}

# 시스템 포트: 파일을 옮겨 대상을 교체한다.
ppg__sys_move() {
	mv -f -- "$1" "$2" 2>/dev/null
}

# 시스템 포트: 신호에 동작 문자열을 건다.
# shellcheck disable=SC2064 # 동작 문자열은 호출자가 작은따옴표로 만든 그대로 건다
ppg__sys_trap() {
	trap "$1" "$2"
}

# === 계층: 인터페이스 ===

ppg__if_usage() {
	printf '%s\n' \
		'사용법:' \
		'  project-path-gateway init [TARGET_DIR]   프로젝트에 .tools/project-path-gateway/를 만들고 라이브러리를 설치·교체합니다' \
		'  project-path-gateway --help | -h          이 도움말을 출력합니다' \
		'  project-path-gateway --version            버전을 출력합니다' \
		'' \
		'TARGET_DIR을 생략하면 현재 작업 디렉터리를 프로젝트 루트로 초기화합니다.'
}

# 출력 포트 구현: 파일별 처리 결과 보고.
ppg__out_action() {
	case $1 in
	create) ppg_if_label=생성 ;;
	keep) ppg_if_label=유지 ;;
	replace) ppg_if_label=교체 ;;
	*) ppg_if_label=$1 ;;
	esac
	printf 'project-path-gateway: %s: %s\n' "$ppg_if_label" "$2"
}

ppg__out_done() {
	printf 'project-path-gateway: 초기화 완료: %s\n' "$1"
}

# 출력 포트 구현: 1.x 데이터 파일 안내 (기능 007 contracts/cli-init.md 2절). 반환값에는 영향이 없다.
ppg__out_legacy_notice() {
	printf 'project-path-gateway: init: 이전 형식 데이터 파일이 있습니다: %s. README의 "1.x 프로젝트 옮기기" 절차로 항목을 옮기세요\n' "$1" >&2
}

# 출력 포트 구현: 실패 보고 (contracts/cli.md 2.1절, 2.2절).
ppg__out_failure() {
	case $1 in
	not_dir) ppg_if_message="디렉터리가 아닙니다: $2" ;;
	tool_not_dir) ppg_if_message=".tools이 디렉터리가 아닙니다: $2" ;;
	tool_dir_not_dir) ppg_if_message="도구 디렉터리가 디렉터리가 아닙니다: $2" ;;
	dir_not_dir) ppg_if_message="디렉터리가 아닙니다: $2" ;;
	not_regular) ppg_if_message="일반 파일이 아닙니다: $2" ;;
	no_library) ppg_if_message="라이브러리 원본을 찾지 못했습니다: $2. 설치 스크립트를 다시 실행하세요" ;;
	no_skill) ppg_if_message="스킬 원본을 찾지 못했습니다: $2. 설치 스크립트를 다시 실행하세요" ;;
	write) ppg_if_message="파일을 쓰지 못했습니다: $2" ;;
	*) ppg_if_message="알 수 없는 오류입니다: $1 $2" ;;
	esac
	printf 'project-path-gateway: init: %s\n' "$ppg_if_message" >&2
}

# 초기화 결과 매핑: 애플리케이션 결과 코드를 종료 코드로 바꾼다 (0 → 0, 10 → 2, 그 밖 → 1).
ppg__if_init_result() {
	case $1 in
	0) return 0 ;;
	10) return 2 ;;
	*) return 1 ;;
	esac
}

# 종료와 중단 신호에 임시 파일 정리를 건다. dash는 신호로 끝날 때 EXIT trap을 실행하지 않으므로
# INT, TERM을 따로 건다 (research R-10). 정리와 trap 설정은 애플리케이션에 위임한다.
ppg__if_set_traps() {
	# shellcheck disable=SC2034 # trap 동작 문자열 안에서 참조한다
	PPG_IF_TARGET=$1
	ppg__app_arm_cleanup 'ppg__app_cleanup "$PPG_IF_TARGET"' EXIT
	ppg__app_arm_cleanup 'ppg__app_cleanup "$PPG_IF_TARGET"; exit 130' INT
	ppg__app_arm_cleanup 'ppg__app_cleanup "$PPG_IF_TARGET"; exit 143' TERM
}

main() {
	case ${1-} in
	--help | -h)
		ppg__if_usage
		exit 0
		;;
	--version)
		printf 'project-path-gateway %s\n' "$PPG_VERSION"
		exit 0
		;;
	init)
		shift
		if [ "$#" -gt 1 ]; then
			printf 'project-path-gateway: init: 인자는 0개 또는 1개여야 합니다\n' >&2
			exit 2
		fi
		ppg__if_set_traps "${1-.}"
		ppg__app_init_project "${1-.}"
		ppg__if_init_result "$?"
		exit "$?"
		;;
	'')
		ppg__if_usage >&2
		exit 2
		;;
	*)
		printf 'project-path-gateway: 알 수 없는 명령입니다: %s\n' "$1" >&2
		ppg__if_usage >&2
		exit 2
		;;
	esac
}

[ "${PPG_SOURCE_ONLY-}" = 1 ] || main "$@"
