# 인프라 통합: 링크를 모두 따라간 최종 물리 경로 (기능 001 verify_filesystem_test, FR-031~FR-035, research R-05)
target lib-func project_path_gateway__port_resolve_physical
layer infra

case resolve-link-to-outside-directory
fs dir /t/outside
fs dir /t/root
fs link /t/root/link /t/outside
arg /t/root/link
status 0
out-raw /t/outsidex
op is-dir /t/root/link
op physical-dir /t/root/link

case resolve-relative-file-link-to-outside
fs file /t/outside/f
fs dir /t/root/d
fs link /t/root/d/link ../../outside/f
arg /t/root/d/link
status 0
out-raw /t/outside/fx
op is-dir /t/root/d/link
op physical-dir /t/root/d
op is-link /t/root/d/link
op readlink /t/root/d/link
op is-dir /t/root/d/../../outside/f
op physical-dir /t/root/d/../../outside
op is-link /t/outside/f

case resolve-broken-link-keeps-last-target
fs dir /t/root
fs link /t/root/link /t/root/nope
arg /t/root/link
status 0
out-raw /t/root/nopex
op is-dir /t/root/link
op physical-dir /t/root
op is-link /t/root/link
op readlink /t/root/link
op is-dir /t/root/nope
op physical-dir /t/root
op is-link /t/root/nope

case resolve-cyclic-link-fails
fs dir /t/root
fs link /t/root/a b
fs link /t/root/b a
arg /t/root/a
status 1
op is-dir /t/root/a
op physical-dir /t/root
op is-link /t/root/a
op readlink /t/root/a
op is-dir /t/root/b
op physical-dir /t/root
op is-link /t/root/b
op readlink /t/root/b
op is-dir /t/root/a
op physical-dir /t/root
