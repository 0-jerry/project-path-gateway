# 애플리케이션 통합: 종류별 키 조회 흐름 project_path_gateway__app_lookup ROOT KIND KEY (기능 001 library_get_contract_test / 기능 007 research R-05)
# 조회는 호출마다 두 데이터 파일을 다시 읽는다. 초기화 뒤 데이터 파일이 바뀌거나 루트가 지워진 경우
# (기능 001 test_data_file_changes_after_init, test_root_deleted_after_init)는 같은 루트에 다른 포트 응답을 준 사례 쌍으로 확인한다.
# 반환: 0 성공, 3 규칙 위반, 4·15 읽기 불가(상세: 데이터 파일 경로), 7 미등록 키, 14 다른 종류의 키.
target lib-func project_path_gateway__app_lookup
layer app

case lookup-registered-dir-key
arg /r
arg dir
arg SRC
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.dirs.conf
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.files.conf
stub project_path_gateway__port_read_lines 0 /r/.tools/project-path-gateway/project-path-gateway.dirs.conf
