# 애플리케이션 통합: 키 조회 흐름 (기능 001 library_get_contract_test, contracts/library-api.md 3절)
# 조회는 호출마다 readable_file·read_lines로 데이터 파일을 다시 읽는다. 초기화 뒤 데이터 파일이 바뀌거나 루트가 지워진 경우
# (기능 001 test_data_file_changes_after_init, test_root_deleted_after_init)는 같은 루트에 다른 포트 응답을 준 사례 쌍으로 확인한다.
target lib-func project_path_gateway__app_lookup
layer app

case lookup-registered-key
arg /r
arg BUILD
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub project_path_gateway__port_read_lines 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub-out A=a
stub-out BUILD=scripts/build.sh
status 0
out /r/scripts/build.sh
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tools/project-path-gateway/project-path-gateway.conf

case lookup-first-entry-when-prefix-keys
arg /r
arg AB
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub project_path_gateway__port_read_lines 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub-out A=a
stub-out ABC=c
stub-out AB=b
status 0
out /r/b
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tools/project-path-gateway/project-path-gateway.conf

case lookup-path-kept-as-written
arg /r
arg K
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub project_path_gateway__port_read_lines 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub-out K=a//b/./c/ d
status 0
out /r/a//b/./c/ d
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tools/project-path-gateway/project-path-gateway.conf

case lookup-unregistered-key
arg /r
arg MISSING
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub project_path_gateway__port_read_lines 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub-out A=a
status 7
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tools/project-path-gateway/project-path-gateway.conf

case lookup-no-entries
arg /r
arg A
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub project_path_gateway__port_read_lines 0 /r/.tools/project-path-gateway/project-path-gateway.conf
status 7
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tools/project-path-gateway/project-path-gateway.conf

case lookup-violation-in-data-file
arg /r
arg A
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub project_path_gateway__port_read_lines 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub-out A=a
stub-out B=/abs
stub project_path_gateway__out_violation 0 /r/.tools/project-path-gateway/project-path-gateway.conf 2 absolute_path B \e 0
status 3
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__out_violation /r/.tools/project-path-gateway/project-path-gateway.conf 2 absolute_path B \e 0

case lookup-unreadable-data-file
arg /r
arg A
stub project_path_gateway__port_readable_file 1 /r/.tools/project-path-gateway/project-path-gateway.conf
status 4
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf

case lookup-after-data-file-changed-reads-new-content
arg /r
arg A
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub project_path_gateway__port_read_lines 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub-out A=changed
status 0
out /r/changed
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tools/project-path-gateway/project-path-gateway.conf

case lookup-after-root-deleted-reads-again
arg /r
arg A
stub project_path_gateway__port_readable_file 1 /r/.tools/project-path-gateway/project-path-gateway.conf
status 4
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf
