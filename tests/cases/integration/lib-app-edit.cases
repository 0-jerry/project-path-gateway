# 애플리케이션 통합: 등록·갱신 흐름 project_path_gateway__app_edit OP KIND ROOT KEY PATH (기능 004 research R-01, data-model 2·4절 / 기능 007 research R-04·R-05)
# 반환: 0 성공(갱신 같은 경로 포함), 9 인자 규칙 위반(stdout 위반 코드), 3·4·15 데이터 파일 오류, 10 이미 등록된 키, 7 미등록 키,
# 14 다른 종류의 키, 11 데이터 파일이 링크, 12 쓰기 권한 없음, 13 교체 실패. 9·3 밖의 실패는 관련 데이터 파일 경로를 끝 표지 방식으로 출력한다.
target lib-func project_path_gateway__app_edit
layer app

# 인자 규칙 위반은 포트를 부르지 않는다 (기능 004 FR-015, 기능 007 FR-012: 키 → 경로 규칙 → 종류 규칙)

case app-edit-invalid-add-key
arg add
arg dir
arg /r
arg docs
arg a
status 9
out invalid_key

case app-edit-invalid-update-path
arg update
arg dir
arg /r
arg DOCS_DIR
arg ../a
status 9
out parent_segment

case app-edit-invalid-add-line-feed
arg add
arg dir
arg /r
arg K
arg a\nb
status 9
out line_feed

case app-edit-invalid-add-dir-with-file-shape
arg add
arg dir
arg /r
arg NOTE
arg note.md
status 9
out not_dir_path

case app-edit-invalid-add-file-with-dir-shape
arg add
arg file
arg /r
arg SRC
arg src
status 9
out not_file_path

case app-edit-invalid-update-file-trailing-slash
arg update
arg file
arg /r
arg CONF
arg app.json/
status 9
out not_file_path

case app-edit-invalid-add-unreadable-data-file
arg add
arg dir
arg /r
arg K
arg a
stub project_path_gateway__port_readable_file 1 /r/.tools/project-path-gateway/project-path-gateway.dirs.conf
stub project_path_gateway__port_readable_file 1 /r/.tools/project-path-gateway/project-path-gateway.conf
status 4
out-raw /r/.tools/project-path-gateway/project-path-gateway.dirs.confx
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.dirs.conf
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf

case app-edit-invalid-add-unreadable-with-legacy-data-file
arg add
arg file
arg /r
arg K
arg a.txt
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.dirs.conf
stub project_path_gateway__port_readable_file 1 /r/.tools/project-path-gateway/project-path-gateway.files.conf
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.conf
status 15
out-raw /r/.tools/project-path-gateway/project-path-gateway.files.confx
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.dirs.conf
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.files.conf
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf

case app-edit-invalid-update-data-file-violation
arg update
arg dir
arg /r
arg K
arg a
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.dirs.conf
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.files.conf
stub project_path_gateway__port_read_lines 0 /r/.tools/project-path-gateway/project-path-gateway.dirs.conf
stub-out K=a
stub-out bad
stub project_path_gateway__port_read_lines 0 /r/.tools/project-path-gateway/project-path-gateway.files.conf
stub project_path_gateway__out_violation 0 /r/.tools/project-path-gateway/project-path-gateway.dirs.conf 2 no_separator \e \e 0 dir
status 3
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.dirs.conf
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.files.conf
op port project_path_gateway__port_read_lines /r/.tools/project-path-gateway/project-path-gateway.dirs.conf
