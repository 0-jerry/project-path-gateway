stub project_path_gateway__port_read_file 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub-out-raw # 주석\nK=ax
stub project_path_gateway__port_replace_data_file 3 /r/.tools/project-path-gateway/project-path-gateway.conf #\s주석\nK=a\nNEW_DIR=new\n
status 13
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_file /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_replace_data_file /r/.tools/project-path-gateway/project-path-gateway.conf #\s주석\nK=a\nNEW_DIR=new\n

