# 애플리케이션 통합: 등록·갱신 흐름 project_path_gateway__app_edit MODE ROOT KEY PATH (기능 004 research R-01, data-model 2·4절)
# 반환: 0 성공(갱신 같은 경로 포함), 9 인자 규칙 위반(stdout 위반 코드), 3·4 데이터 파일 오류, 10 이미 등록된 키, 7 미등록 키,
# 11 데이터 파일이 링크, 12 쓰기 권한 없음, 13 교체 실패.
target lib-func project_path_gateway__app_edit
layer app

# 인자 규칙 위반은 포트를 부르지 않는다 (FR-015)
case app-edit-invalid-add-key
arg add
arg /r
arg docs
arg a
status 9
out invalid_key

case app-edit-invalid-update-path
arg update
arg /r
arg DOCS_DIR
arg ../a
status 9
out parent_segment

case app-edit-invalid-add-line-feed
arg add
arg /r
arg K
arg a\nb
status 9
out line_feed

case app-edit-invalid-add-unreadable-data-file
arg add
arg /r
arg K
arg a
stub project_path_gateway__port_readable_file 1 /r/.tools/project-path-gateway/project-path-gateway.conf
status 4
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf

case app-edit-invalid-update-data-file-violation
arg update
arg /r
arg K
arg a
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub project_path_gateway__port_read_lines 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub-out K=a
stub-out bad
stub project_path_gateway__port_report_violation 0 /r/.tools/project-path-gateway/project-path-gateway.conf 2 no_separator \e \e 0
status 3
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_report_violation /r/.tools/project-path-gateway/project-path-gateway.conf 2 no_separator \e \e 0

# 등록 성공과 교체 결과 코드 (US1, FR-020, research R-01 7~9단계)
case app-edit-add-success
arg add
arg /r
arg NEW_DIR
arg new
stub project_path_gateway__port_readable_file 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub project_path_gateway__port_read_lines 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub-out # 주석
stub-out K=a
stub project_path_gateway__port_read_file 0 /r/.tools/project-path-gateway/project-path-gateway.conf
stub-out-raw # 주석\nK=ax
stub project_path_gateway__port_replace_data_file 0 /r/.tools/project-path-gateway/project-path-gateway.conf #\s주석\nK=a\nNEW_DIR=new\n
status 0
op port project_path_gateway__port_readable_file /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_file /r/.tools/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_replace_data_file /r/.tools/project-path-gateway/project-path-gateway.conf #\s주석\nK=a\nNEW_DIR=new\n

