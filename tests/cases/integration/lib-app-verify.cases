# 애플리케이션 통합: 전체 검증 흐름 (기능 001 library_verify_contract_test, contracts/library-api.md 4절)
# 항목마다 exists → resolve_physical → 루트 내부 판정 순서로 보고, 누락 항목은 루트 밖 검사를 하지 않는다.
target lib-func project_path_gateway__app_verify
layer app

case verify-all-pass
arg /r
stub project_path_gateway__port_readable_file 0 /r/.tool/project-path-gateway/project-path-gateway.conf
stub project_path_gateway__port_read_lines 0 /r/.tool/project-path-gateway/project-path-gateway.conf
stub-out A=a
stub-out B=b/c
stub project_path_gateway__port_exists 0 /r/a
stub project_path_gateway__port_resolve_physical 0 /r/a
stub-out-raw /r/ax
stub project_path_gateway__port_exists 0 /r/b/c
stub project_path_gateway__port_resolve_physical 0 /r/b/c
stub-out-raw /r/b/cx
status 0
out ok 2
op port project_path_gateway__port_readable_file /r/.tool/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tool/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_exists /r/a
op port project_path_gateway__port_resolve_physical /r/a
op port project_path_gateway__port_exists /r/b/c
op port project_path_gateway__port_resolve_physical /r/b/c

case verify-no-entries
arg /r
stub project_path_gateway__port_readable_file 0 /r/.tool/project-path-gateway/project-path-gateway.conf
stub project_path_gateway__port_read_lines 0 /r/.tool/project-path-gateway/project-path-gateway.conf
stub-out # 주석
status 0
out ok 0
op port project_path_gateway__port_readable_file /r/.tool/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tool/project-path-gateway/project-path-gateway.conf

case verify-missing-and-outside-in-file-order
arg /r
stub project_path_gateway__port_readable_file 0 /r/.tool/project-path-gateway/project-path-gateway.conf
stub project_path_gateway__port_read_lines 0 /r/.tool/project-path-gateway/project-path-gateway.conf
stub-out MISS=m
stub-out OUT=link
stub-out OK=ok
stub-out BROKEN=b
stub project_path_gateway__port_exists 1 /r/m
stub project_path_gateway__port_report_missing 0 MISS m
stub project_path_gateway__port_exists 0 /r/link
stub project_path_gateway__port_resolve_physical 0 /r/link
stub-out-raw /elsewherex
stub project_path_gateway__port_report_outside 0 OUT link /elsewhere
stub project_path_gateway__port_exists 0 /r/ok
stub project_path_gateway__port_resolve_physical 0 /r/ok
stub-out-raw /r/okx
stub project_path_gateway__port_exists 0 /r/b
stub project_path_gateway__port_resolve_physical 1 /r/b
stub project_path_gateway__port_report_missing 0 BROKEN b
status 1
out fail 3
op port project_path_gateway__port_readable_file /r/.tool/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tool/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_exists /r/m
op port project_path_gateway__port_report_missing MISS m
op port project_path_gateway__port_exists /r/link
op port project_path_gateway__port_resolve_physical /r/link
op port project_path_gateway__port_report_outside OUT link /elsewhere
op port project_path_gateway__port_exists /r/ok
op port project_path_gateway__port_resolve_physical /r/ok
op port project_path_gateway__port_exists /r/b
op port project_path_gateway__port_resolve_physical /r/b
op port project_path_gateway__port_report_missing BROKEN b

case verify-root-itself-and-similar-prefix
arg /r
stub project_path_gateway__port_readable_file 0 /r/.tool/project-path-gateway/project-path-gateway.conf
stub project_path_gateway__port_read_lines 0 /r/.tool/project-path-gateway/project-path-gateway.conf
stub-out SELF=.
stub-out SIB=x
stub project_path_gateway__port_exists 0 /r/.
stub project_path_gateway__port_resolve_physical 0 /r/.
stub-out-raw /rx
stub project_path_gateway__port_exists 0 /r/x
stub project_path_gateway__port_resolve_physical 0 /r/x
stub-out-raw /r2/xx
stub project_path_gateway__port_report_outside 0 SIB x /r2/x
status 1
out fail 1
op port project_path_gateway__port_readable_file /r/.tool/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tool/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_exists /r/.
op port project_path_gateway__port_resolve_physical /r/.
op port project_path_gateway__port_exists /r/x
op port project_path_gateway__port_resolve_physical /r/x
op port project_path_gateway__port_report_outside SIB x /r2/x

case verify-violation-in-data-file
arg /r
stub project_path_gateway__port_readable_file 0 /r/.tool/project-path-gateway/project-path-gateway.conf
stub project_path_gateway__port_read_lines 0 /r/.tool/project-path-gateway/project-path-gateway.conf
stub-out A=..
stub project_path_gateway__port_report_violation 0 /r/.tool/project-path-gateway/project-path-gateway.conf 1 parent_segment A \e 0
status 3
op port project_path_gateway__port_readable_file /r/.tool/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_read_lines /r/.tool/project-path-gateway/project-path-gateway.conf
op port project_path_gateway__port_report_violation /r/.tool/project-path-gateway/project-path-gateway.conf 1 parent_segment A \e 0

case verify-unreadable-data-file
arg /r
stub project_path_gateway__port_readable_file 1 /r/.tool/project-path-gateway/project-path-gateway.conf
status 4
op port project_path_gateway__port_readable_file /r/.tool/project-path-gateway/project-path-gateway.conf
