# 인프라 통합: 이번 실행에서 만든 디렉터리만 되돌리기 (기능 001 cli_init_test, 기능 006 FR-018 research R-03)
# 인자 없음. PPG_INFRA_CREATED_DIRS는 만든 순서의 역순으로 기록된 LF 목록이므로 앞에서부터 지운다.
# 비어 있지 않은 디렉터리는 rmdir가 실패하고 그 실패는 무시한다.
target bin-func ppg__port_rollback_dirs
layer infra

case rollback-dirs-both-created
fs dir /p/.tools/project-path-gateway
env PPG_INFRA_CREATED_DIRS /p/.tools/project-path-gateway\n/p/.tools\n
status 0
op rmdir /p/.tools/project-path-gateway
op rmdir /p/.tools

case rollback-dirs-only-tool-dir-created
fs dir /p/.tools/project-path-gateway
env PPG_INFRA_CREATED_DIRS /p/.tools/project-path-gateway\n
status 0
op rmdir /p/.tools/project-path-gateway

case rollback-dirs-nothing-created
fs dir /p/.tools/project-path-gateway
status 0

case rollback-dirs-empty-record
fs dir /p/.tools/project-path-gateway
env PPG_INFRA_CREATED_DIRS \e
status 0

case rollback-dirs-not-empty-kept
fs file /p/.tools/project-path-gateway/other
env PPG_INFRA_CREATED_DIRS /p/.tools/project-path-gateway\n/p/.tools\n
status 0
op rmdir /p/.tools/project-path-gateway
op rmdir /p/.tools

case rollback-dirs-path-with-space-and-korean
fs dir /t/my\sproject/한글/.agents/skills
env PPG_INFRA_CREATED_DIRS /t/my\sproject/한글/.agents/skills\n/t/my\sproject/한글/.agents\n
status 0
op rmdir /t/my\sproject/한글/.agents/skills
op rmdir /t/my\sproject/한글/.agents
