# 인프라 통합: 원본을 임시 파일에 복사하고 새 파일로 연결 (기능 001 cli_init_test, research R-10)
target bin-func ppg__port_copy_new
layer infra
fs dir /p/.tool/project-path-gateway
fs file /opt/share/lib.sh
content LIB

case copy-new-library
arg /p/.tool/project-path-gateway/project-path-gateway.sh
arg /opt/share/lib.sh
status 0
op pid
op copy /opt/share/lib.sh /p/.tool/project-path-gateway/.ppg-tmp.4242.project-path-gateway.sh
op link /p/.tool/project-path-gateway/.ppg-tmp.4242.project-path-gateway.sh /p/.tool/project-path-gateway/project-path-gateway.sh
op remove /p/.tool/project-path-gateway/.ppg-tmp.4242.project-path-gateway.sh

case copy-new-copy-fails
fault copy /p/.tool/project-path-gateway/.ppg-tmp.4242.project-path-gateway.sh
arg /p/.tool/project-path-gateway/project-path-gateway.sh
arg /opt/share/lib.sh
status 1
op pid
op copy /opt/share/lib.sh /p/.tool/project-path-gateway/.ppg-tmp.4242.project-path-gateway.sh
op remove /p/.tool/project-path-gateway/.ppg-tmp.4242.project-path-gateway.sh

case copy-new-link-fails
fault link /p/.tool/project-path-gateway/project-path-gateway.sh
arg /p/.tool/project-path-gateway/project-path-gateway.sh
arg /opt/share/lib.sh
status 1
op pid
op copy /opt/share/lib.sh /p/.tool/project-path-gateway/.ppg-tmp.4242.project-path-gateway.sh
op link /p/.tool/project-path-gateway/.ppg-tmp.4242.project-path-gateway.sh /p/.tool/project-path-gateway/project-path-gateway.sh
op remove /p/.tool/project-path-gateway/.ppg-tmp.4242.project-path-gateway.sh
