# 도메인 단위: 항목 목록 모델 본 키 목록 등록 (기능 001 domain_line_test_seen_keys / 기능 005 FR-004 / 기능 007 data-model 1.5, research R-06)
# 인자: 본 키 목록(":KEY=종류/줄번호:" 연결), 레코드. 처음 본 키: 반환 0·새 목록(끝 LF 없음).
# 이미 본 키: 반환 1·처음 정의된 위치 "종류/줄번호". 본 키 목록은 두 데이터 파일에 걸쳐 이어 쓴다.
target lib-func project_path_gateway__domain_seen_register
layer domain

case seen-add-to-empty
arg \e
arg dir\t2\tAB\tx
status 0
out-raw :AB=dir/2:

case seen-add-second
arg :AB=dir/2:
arg dir\t5\tA\tx
status 0
out-raw :AB=dir/2:A=dir/5:

case seen-add-file-kind
arg :AB=dir/2:
arg file\t1\tCONF\tapp.json
status 0
out-raw :AB=dir/2:CONF=file/1:

case seen-lineno-empty-list
arg \e
arg dir\t1\tA\tx
status 0
out-raw :A=dir/1:

case seen-lineno-a
arg :AB=dir/2:A=dir/5:B_1=dir/9:
arg dir\t12\tA\tp
status 1
out dir/5

case seen-lineno-ab
arg :AB=dir/2:A=dir/5:B_1=dir/9:
arg dir\t12\tAB\tp
status 1
out dir/2

case seen-lineno-b-1
arg :AB=dir/2:A=dir/5:B_1=dir/9:
arg dir\t12\tB_1\tp
status 1
out dir/9

case seen-lineno-prefix-only
arg :AB=dir/2:A=dir/5:B_1=dir/9:
arg dir\t12\tB\tp
status 0
out-raw :AB=dir/2:A=dir/5:B_1=dir/9:B=dir/12:

case seen-lineno-missing
arg :AB=dir/2:A=dir/5:B_1=dir/9:
arg dir\t12\tC\tp=q\tr
status 0
out-raw :AB=dir/2:A=dir/5:B_1=dir/9:C=dir/12:

case seen-other-kind-duplicate
arg :SRC=dir/3:
arg file\t1\tSRC\tx.txt
status 1
out dir/3

case seen-same-file-kind-duplicate
arg :SRC=dir/3:CONF=file/2:
arg file\t7\tCONF\tother.json
status 1
out file/2
