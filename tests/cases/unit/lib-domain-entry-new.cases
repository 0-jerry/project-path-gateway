# 도메인 단위: 항목 모델 레코드 생성 (기능 005 FR-004 / 기능 007 FR-003, data-model 1.3). 레코드는 끝 LF를 포함해 출력한다.
# 인자: KIND LINENO KEY PATH. 표현: 종류<TAB>줄번호<TAB>키<TAB>경로
target lib-func project_path_gateway__domain_entry_new
layer domain

case entry-new-simple
arg dir
arg 3
arg A
arg b
status 0
out dir\t3\tA\tb

case entry-new-file-kind
arg file
arg 4
arg BUILD_SCRIPT
arg scripts/build.sh
status 0
out file\t4\tBUILD_SCRIPT\tscripts/build.sh

case entry-new-path-with-tab-and-equal
arg dir
arg 12
arg DOCS_DIR
arg a\tb=c
status 0
out dir\t12\tDOCS_DIR\ta\tb=c

case entry-new-path-with-edge-spaces-and-korean
arg dir
arg 1
arg K
arg \s한글\s
status 0
out dir\t1\tK\t 한글 
