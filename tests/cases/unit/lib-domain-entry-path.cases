# 도메인 단위: 항목 모델 필드 접근 - 경로 (기능 005 FR-004 / 기능 007 data-model 1.3). 셋째 TAB 뒤 전체이며 끝 LF 없이 출력한다.
target lib-func project_path_gateway__domain_entry_path
layer domain

case entry-path-simple
arg dir\t3\tA\tb
status 0
out-raw b

case entry-path-keeps-tab-and-equal
arg dir\t3\tA\ta\tb=c
status 0
out-raw a\tb=c

case entry-path-keeps-edge-spaces-and-korean
arg dir\t3\tA\t\s한글\s
status 0
out-raw  한글 

case entry-path-file-kind
arg file\t9\tCONF\tconfig/app.json
status 0
out-raw config/app.json
