# 도메인 단위: 항목 목록 모델 project_path_gateway__domain_entries_list_violations CHECKED (기능 008 data-model 2.2)
# 판정 스트림의 위반마다 줄 번호, 코드, 키, 상세1, 상세2 다섯 줄을 낸다. 위반 안의 줄이 V·A·K와 같아도 개수로 건너뛴다.
target lib-func project_path_gateway__domain_entries_list_violations
layer domain

case list-violations-none
arg A\tdir\t1\tSRC\tsrc\nK\t2\tAPP
status 0

case list-violations-in-order
arg A\tdir\t1\tSRC\tsrc\nV\n2\nduplicate_key\nV\n1\n\nK\t3\tAPP\nV\n4\nkey_conflict\nA\ndir\nsrc
status 0
out 2
out duplicate_key
out V
out 1
out
out 4
out key_conflict
out A
out dir
out src
