# 도메인 단위: 항목 줄의 경로 (기능 001 domain_line_test_line_key_and_path)
target lib-func project_path_gateway__domain_line_path
layer domain

case line-path-keeps-leading-space
arg A=\sb
status 0
out-raw  b

case line-path-after-first-equal
arg A=b=c
status 0
out-raw b=c

case line-path-keeps-trailing-space
arg A=b\s
status 0
out-raw b 
