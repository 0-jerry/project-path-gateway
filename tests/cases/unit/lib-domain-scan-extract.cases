# 도메인 단위: 찾기 모델 project_path_gateway__domain_scan_extract ROOT RECORDS LINES (기능 008 research R-04, data-model 3.2)
# 스크립트 스트림에서 경로 표기를 뽑아 해석 대상 T(번호, 분류 p·b·r, 1순위, 2순위)와 발견 위치 O(번호, 스크립트, 줄, 절대 표시, 값 전체 번호, 원문)를 낸다.
# 맨 이름 b는 실제로 있을 때만 후보가 되고, 경로 같음 p는 없으면 확인 필요가 된다(research R-06). 기존 키 K, 등록 경로 G, 스크립트 수 P를 함께 낸다.
target lib-func project_path_gateway__domain_scan_extract
layer domain

# 해석 분류: 맨 이름(b, 루트 기준 1순위 + 스크립트 디렉터리 기준 2순위), / 포함(p), ./·../ 표기(스크립트 디렉터리 기준), .. 루트 참조(r)

case extract-bare-and-slash
arg /r
arg \e
arg F\t/r/scripts/build.sh\nL\tls\ssrc\slib/x.sh
status 0
out ROOT\t/r
out T\t1\tb\tls\tscripts/ls
out O\t1\tscripts/build.sh\t1\t-\t-\tls
out T\t2\tb\tsrc\tscripts/src
out O\t2\tscripts/build.sh\t1\t-\t-\tsrc
out T\t3\tp\tlib/x.sh\tscripts/lib/x.sh
out O\t3\tscripts/build.sh\t1\t-\t-\tlib/x.sh
out P\t1

case extract-dot-relative-from-script-directory
arg /r
arg \e
arg F\t/r/scripts/b.sh\nL\tsh\s./run.sh\s../src\s..\s../..\s.\s../../x
status 0
out ROOT\t/r
out T\t1\tb\tsh\tscripts/sh
out O\t1\tscripts/b.sh\t1\t-\t-\tsh
out T\t2\tp\tscripts/run.sh\t
out O\t2\tscripts/b.sh\t1\t-\t-\t./run.sh
out T\t3\tp\tsrc\t
out O\t3\tscripts/b.sh\t1\t-\t-\t../src
out T\t4\tr\t\t
out O\t4\tscripts/b.sh\t1\t-\t-\t..
out P\t1

case extract-script-at-root-has-no-second
arg /r
arg \e
arg F\t/r/b.sh\nL\tls\ssrc\s./src\s..
status 0
out ROOT\t/r
out T\t1\tb\tls\t
out O\t1\tb.sh\t1\t-\t-\tls
out T\t2\tb\tsrc\t
out O\t2\tb.sh\t1\t-\t-\tsrc
out T\t3\tp\tsrc\t
out O\t3\tb.sh\t1\t-\t-\t./src
out P\t1

# 따옴표·이스케이프

case extract-quotes
arg /r
arg \e
arg F\t/r/s/b.sh\nL\tcp\s'a\sb/c.txt'\s"src\\"x"\s'unclosed/x.txt
status 0
out ROOT\t/r
out T\t1\tb\tcp\ts/cp
out O\t1\ts/b.sh\t1\t-\t-\tcp
out T\t2\tb\ta b/c.txt\ts/a b/c.txt
out O\t2\ts/b.sh\t1\t-\t-\t'a b/c.txt'
out T\t3\tb\ta\ts/a
out O\t3\ts/b.sh\t1\t-\t2\t'a b/c.txt'
out T\t4\tp\tb/c.txt\ts/b/c.txt
out O\t4\ts/b.sh\t1\t-\t2\t'a b/c.txt'
out T\t5\tb\tsrc"x\ts/src"x
out O\t5\ts/b.sh\t1\t-\t-\t"src\\"x"
out T\t6\tp\tunclosed/x.txt\ts/unclosed/x.txt
out O\t6\ts/b.sh\t1\t-\t-\t'unclosed/x.txt
out P\t1

case extract-escaped-space-and-backslash
arg /r
arg \e
arg F\t/r/b.sh\nL\tcp\ssrc\\\sdir/a.txt\sb\\\\c
status 0
out ROOT\t/r
out T\t1\tb\tcp\t
out O\t1\tb.sh\t1\t-\t-\tcp
out T\t2\tb\tsrc dir/a.txt\t
out O\t2\tb.sh\t1\t-\t-\tsrc\\ dir/a.txt
out T\t3\tb\tsrc\t
out O\t3\tb.sh\t1\t-\t2\tsrc\\ dir/a.txt
out T\t4\tp\tdir/a.txt\t
out O\t4\tb.sh\t1\t-\t2\tsrc\\ dir/a.txt
out P\t1

# 치환: 치환 뒤 / 다음 부분, 명령 치환 안 다시 처리

case extract-after-substitution
arg /r
arg \e
arg F\t/r/s/b.sh\nL\tcat\s"$ROOT/config/app.json"\s${X}/lib/a.sh\s$(pwd)/out/x.txt\s`pwd`/y/z.txt\s"$(dirname\s"$0")/.."\s$X/lib
status 0
out ROOT\t/r
out T\t1\tb\tcat\ts/cat
out O\t1\ts/b.sh\t1\t-\t-\tcat
out T\t2\tp\tconfig/app.json\ts/config/app.json
out O\t2\ts/b.sh\t1\t-\t-\t"$ROOT/config/app.json"
out T\t3\tp\tlib/a.sh\ts/lib/a.sh
out O\t3\ts/b.sh\t1\t-\t-\t${X}/lib/a.sh
out T\t4\tb\tpwd\ts/pwd
out O\t4\ts/b.sh\t1\t-\t-\tpwd
out T\t5\tp\tout/x.txt\ts/out/x.txt
out O\t5\ts/b.sh\t1\t-\t-\t$(pwd)/out/x.txt
out O\t4\ts/b.sh\t1\t-\t-\tpwd
out T\t6\tp\ty/z.txt\ts/y/z.txt
out O\t6\ts/b.sh\t1\t-\t-\t`pwd`/y/z.txt
out T\t7\tb\tdirname\ts/dirname
out O\t7\ts/b.sh\t1\t-\t-\tdirname
out T\t8\tr\t\t
out O\t8\ts/b.sh\t1\t-\t-\t"$(dirname "$0")/.."
out T\t9\tb\tlib\ts/lib
out O\t9\ts/b.sh\t1\t-\t-\t$X/lib
out P\t1

case extract-inside-command-substitution
