out T\t2\tp\tconf/a.conf\ts/conf/a.conf
out O\t2\ts/b.sh\t1\t-\t-\tconf/a.conf
out T\t3\tb\tgrep\ts/grep
out O\t3\ts/b.sh\t1\t-\t-\tgrep
out T\t4\tb\tx\ts/x
out O\t4\ts/b.sh\t1\t-\t-\tx
out T\t5\tp\tdata/b.txt\ts/data/b.txt
out O\t5\ts/b.sh\t1\t-\t-\t"data/b.txt"
out P\t1

case extract-parameters-without-relative-part
arg /r
arg \e
arg F\t/r/b.sh\nL\techo\s${X:-a/b.txt}\s$((1+2))\s"${Y}"/c.txt\s$1/d.txt\s$$\s$?x
status 0
out ROOT\t/r
out T\t1\tb\techo\t
out O\t1\tb.sh\t1\t-\t-\techo
out T\t2\tb\tc.txt\t
out O\t2\tb.sh\t1\t-\t-\t"${Y}"/c.txt
out T\t3\tb\td.txt\t
out O\t3\tb.sh\t1\t-\t-\t$1/d.txt
out P\t1

