arg S\t1\tok\tdir\t-\tsrc\nS\t2\tok\tdir\t-\tsrc
status 0
out N\t2\t1\t0\t0\t0\t0
out C\tnew\tdir\tSRC\tsrc
out @\ta/b.sh\t9\t-\t./src
out @\ta/b.sh\t9\t-\tsrc
out @\ta/b.sh\t9\ta\t/r/src
out @\ta/b.sh\t10\t-\tsrc
out @\tz.sh\t1\t-\tsrc

