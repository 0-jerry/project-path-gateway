# 도메인 단위: 항목 모델 필드 접근 - 종류 (기능 007 FR-003, data-model 1.3). 끝 LF 없이 출력한다.
target lib-func project_path_gateway__domain_entry_kind
layer domain

case entry-kind-dir
arg dir\t3\tA\tb
status 0
out-raw dir

case entry-kind-file
arg file\t1\tBUILD_SCRIPT\tscripts/build.sh
status 0
out-raw file

case entry-kind-path-with-tab
arg file\t120\tA\ta\tb.txt
status 0
out-raw file
