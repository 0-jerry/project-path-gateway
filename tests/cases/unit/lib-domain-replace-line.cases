# 도메인 단위: 갱신 새 원문 조립 (기능 004 FR-021, research R-05, data-model 1.2·1.4)
# 원문을 LF 기준으로 나눠 LINENO번째 줄 내용만 LINE으로 바꾼다. LF 위치와 파일 끝 LF 유무는 그대로. 출력은 끝 표지 방식.
target lib-func project_path_gateway__domain_replace_line
layer domain

case replace-line-first
arg A=a\nB=b\nC=c\n
arg 1
arg A=x
status 0
out-raw A=x\nB=b\nC=c\nx

case replace-line-middle
arg A=a\nB=b\nC=c\n
arg 2
arg B=new/b
status 0
out-raw A=a\nB=new/b\nC=c\nx

case replace-line-last
arg A=a\nB=b\nC=c\n
arg 3
arg C=x
status 0
out-raw A=a\nB=b\nC=x\nx

case replace-line-last-without-lf-is-target
arg A=a\nB=b
arg 2
arg B=x
status 0
out-raw A=a\nB=xx

case replace-line-last-without-lf-not-target
arg A=a\nB=b
arg 1
arg A=x
status 0
out-raw A=x\nB=bx

case replace-line-blank-comment-cr-mixed
arg #\sc\r\n\nA=a\n\n#x\nB=b\n
arg 6
arg B=new
status 0
out-raw # c\r\n\nA=a\n\n#x\nB=new\nx

case replace-line-blank-lines-before-target
arg \n\nA=a\n
arg 3
arg A=x
status 0
out-raw \n\nA=x\nx

case replace-line-single-line
arg A=a\n
arg 1
arg A=b
status 0
out-raw A=b\nx

case replace-line-number-past-end
arg A=a\n
arg 2
arg A=b
status 1

case replace-line-number-past-end-without-lf
arg A=a
arg 2
arg A=b
status 1

case replace-line-special-bytes
arg A=a\nK=k\n
arg 2
arg K=\\%/-x/*
status 0
out-raw A=a\nK=\\%/-x/*\nx
