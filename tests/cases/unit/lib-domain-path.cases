# 도메인 단위: 경로 모델 위반 판정 (기능 001 domain_path_test, FR-015 / 기능 005 FR-003: line_feed 흡수 / 기능 007: 위반이면 반환 1)
target lib-func project_path_gateway__domain_path_violation
layer domain

case path-violation-empty
arg \e
status 1
out empty_path

case path-violation-absolute-etc
arg /etc
status 1
out absolute_path

case path-violation-absolute-root
arg /
status 1
out absolute_path

case path-violation-parent-only
arg ..
status 1
out parent_segment

case path-violation-parent-leading
arg ../a
status 1
out parent_segment

case path-violation-parent-trailing
arg a/..
status 1
out parent_segment

case path-violation-parent-middle
arg a/../b
status 1
out parent_segment

case path-violation-cr-trailing
arg a\r
status 1
out carriage_return

case path-violation-cr-middle
arg a\rb
status 1
out carriage_return

case path-allowed-space
arg a\sb
status 0

case path-allowed-korean
arg 한글/경로
status 0

case path-allowed-equal
arg a=b
status 0

case path-allowed-dot-leading
arg ./a
status 0

case path-allowed-empty-segment
arg a//b
status 0

case path-allowed-trailing-slash
arg dir/
status 0

case path-allowed-hyphen
arg -a
status 0

case path-allowed-three-dots
arg ...
status 0

case path-allowed-dotdot-prefix
arg ..a
status 0

case path-allowed-dotdot-suffix
arg a..
status 0

case path-allowed-single-dot
arg .
status 0

case path-allowed-dot-middle
arg a/./b
status 0

case path-line-feed
arg a\nb
status 1
out line_feed

case path-carriage-return-before-line-feed
arg a\r\nb
status 1
out carriage_return

case path-line-feed-at-end
arg a\n
status 1
out line_feed

# 기능 007 FR-016·FR-017: 종류 인자 KIND가 있으면 기존 위반 뒤에 경로 모양을 판정한다
# (data-model.md 1.2 표. 종류 인자가 없는 위 사례들은 그대로 모양을 보지 않는다)

case path-kind-dir-single-dot
arg .
arg dir
status 0

case path-kind-file-single-dot
arg .
arg file
status 1
out not_file_path

case path-kind-dir-dot-segment
arg dir/.
arg dir
status 0

case path-kind-file-dot-segment
arg dir/.
arg file
status 1
out not_file_path

case path-kind-dir-dot-slash
arg ./
arg dir
status 0

case path-kind-file-dot-slash
arg ./
arg file
status 1
out not_file_path

case path-kind-dir-dotfile
arg .gitignore
arg dir
status 1
out not_dir_path

case path-kind-file-dotfile
arg .gitignore
arg file
status 0

case path-kind-dir-dotdir-name
arg .github
arg dir
status 1
out not_dir_path

case path-kind-file-dotdir-name
arg .github
arg file
status 0

case path-kind-dir-dotenv-local
arg .env.local
arg dir
status 1
out not_dir_path

case path-kind-file-dotenv-local
arg .env.local
arg file
status 0

case path-kind-dir-extension
arg build.sh
arg dir
status 1
out not_dir_path

case path-kind-file-extension
arg build.sh
arg file
status 0

case path-kind-dir-double-extension
arg archive.tar.gz
arg dir
status 1
out not_dir_path

case path-kind-file-double-extension
arg archive.tar.gz
arg file
status 0

case path-kind-dir-version-name
arg v1.2
arg dir
status 1
out not_dir_path

case path-kind-file-version-name
arg v1.2
arg file
status 0

case path-kind-dir-plain-name
arg src
arg dir
status 0

case path-kind-file-plain-name
arg src
arg file
status 1
out not_file_path

case path-kind-dir-trailing-dot-name
arg b.
arg dir
status 0

case path-kind-file-trailing-dot-name
arg b.
arg file
status 1
out not_file_path

case path-kind-dir-no-extension-name
arg Makefile
arg dir
status 0

case path-kind-file-no-extension-name
arg Makefile
arg file
status 1
out not_file_path

case path-kind-file-trailing-slash
arg a.txt/
arg file
status 1
out not_file_path

case path-kind-dir-trailing-slash
arg src/
arg dir
status 0

case path-kind-dir-dotdir-trailing-slash
arg .github/
arg dir
status 1
out not_dir_path

case path-kind-dir-nested-file-shape
arg src/build.sh
arg dir
status 1
out not_dir_path

case path-kind-file-nested-dir-shape
arg src/lib
arg file
status 1
out not_file_path

case path-kind-existing-violation-comes-first
arg /a.txt
arg dir
status 1
out absolute_path

case path-kind-existing-violation-before-file-shape
arg ..
arg file
status 1
out parent_segment

case path-kind-empty-path-before-shape
arg \e
arg file
status 1
out empty_path

case path-kind-cr-before-shape
arg a.txt\r
arg dir
status 1
out carriage_return

case path-kind-line-feed-before-shape
arg src\n
arg file
status 1
out line_feed
