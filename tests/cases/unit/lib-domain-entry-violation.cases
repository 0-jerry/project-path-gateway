# 도메인 단위: 등록·갱신 인자 KIND·KEY·PATH 규칙의 첫 위반 코드 (기능 004 FR-010, FR-015, research R-02 / 기능 007 FR-012)
# 순서: 키 → 경로 규칙 → 종류 규칙.
target lib-func project_path_gateway__domain_entry_violation
layer domain

case entry-violation-valid
arg dir
arg DOCS_DIR
arg docs
status 0

case entry-violation-valid-special-path
arg dir
arg A1_B
arg 내\s문서/a=b/\\%/-x/*/./x//끝/
status 0

case entry-violation-valid-leading-dash
arg dir
arg K
arg -n
status 0

case entry-violation-key-lowercase
arg dir
arg docs
arg docs
status 1
out invalid_key

case entry-violation-key-empty
arg dir
arg \e
arg docs
status 1
out invalid_key

case entry-violation-key-with-equal
arg dir
arg A=B
arg docs
status 1
out invalid_key

case entry-violation-key-leading-digit
arg dir
arg 1A
arg docs
status 1
out invalid_key

case entry-violation-key-and-path-both-wrong
arg dir
arg docs
arg /abs
status 1
out invalid_key

case entry-violation-path-empty
arg dir
arg K
arg \e
status 1
out empty_path

case entry-violation-path-absolute
arg dir
arg K
arg /abs
status 1
out absolute_path

case entry-violation-path-parent-leading
arg dir
arg K
arg ../out
status 1
out parent_segment

case entry-violation-path-parent-middle
arg dir
arg K
arg a/../b
status 1
out parent_segment

case entry-violation-path-parent-only
arg dir
arg K
arg ..
status 1
out parent_segment

case entry-violation-path-cr
arg dir
arg K
arg a\rb
status 1
out carriage_return

case entry-violation-path-lf
arg dir
arg K
arg a\nb
status 1
out line_feed

case entry-violation-path-trailing-lf
arg dir
arg K
arg a\n
status 1
out line_feed

case entry-violation-path-parent-before-cr
arg dir
arg K
arg ../a\r
status 1
out parent_segment

case entry-violation-path-cr-before-lf
arg dir
arg K
arg a\r\nb
status 1
out carriage_return

case entry-violation-file-valid
arg file
arg CONF
arg config/app.json
status 0

case entry-violation-dir-with-file-shape
arg dir
arg NOTE
arg note.md
status 1
out not_dir_path

case entry-violation-file-with-dir-shape
arg file
arg SRC
arg src
status 1
out not_file_path

case entry-violation-file-trailing-slash
arg file
arg CONF
arg app.json/
status 1
out not_file_path

case entry-violation-key-before-kind
arg dir
arg note
arg note.md
status 1
out invalid_key

case entry-violation-path-before-kind
arg file
arg SRC
arg ../src
status 1
out parent_segment
