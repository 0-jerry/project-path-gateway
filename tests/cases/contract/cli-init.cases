op trap TERM ppg__app_cleanup\s"$PPG_IF_TARGET";\sexit\s143
op mkdir ./.tools
op mkdir ./.tools/project-path-gateway
op mkdir ./.agents
op mkdir ./.agents/skills
op mkdir ./.agents/skills/project-path-gateway
op write ./.tools/project-path-gateway/.ppg-tmp.4242..project-path-gateway #\sproject-path-gateway\s루트\s표식\s파일입니다.\s이\s파일을\s담은\s.tools/\s디렉터리의\s상위\s디렉터리가\s프로젝트\s루트입니다.\nformat=1\n
op link ./.tools/project-path-gateway/.ppg-tmp.4242..project-path-gateway ./.tools/project-path-gateway/.project-path-gateway
op remove ./.tools/project-path-gateway/.ppg-tmp.4242..project-path-gateway
op write ./.tools/project-path-gateway/.ppg-tmp.4242.project-path-gateway.conf #\sproject-path-gateway\s데이터\s파일\n#\s한\s줄에\sKEY=경로\s형식으로\s적습니다.\s경로는\s프로젝트\s루트(.tools/의\s상위\s디렉터리)\s기준\s상대경로입니다.\n#\s키:\s대문자로\s시작하고\s대문자·숫자·_만\s사용합니다.\s파일\s안에서\s중복될\s수\s없습니다.\n#\s경로:\s/로\s시작할\s수\s없고\s..\s세그먼트를\s쓸\s수\s없습니다.\s=\s앞뒤\s공백은\s제거되지\s않습니다.\n#\s빈\s줄과\s#으로\s시작하는\s줄은\s무시합니다.\n#\n#\s아래\s두\s항목은\s초기화가\s넣은\s기본\s항목입니다.\s필요하지\s않으면\s지워도\s됩니다.\nPPG_TOOL_DIR=.tools/project-path-gateway\nAGENT_SKILLS_DIR=.agents/skills\n#\n#\s예:\n#\sSOURCES_ROOT=sources\n#\sBUILD_SCRIPT=scripts/build.sh\n
op link ./.tools/project-path-gateway/.ppg-tmp.4242.project-path-gateway.conf ./.tools/project-path-gateway/project-path-gateway.conf
op remove ./.tools/project-path-gateway/.ppg-tmp.4242.project-path-gateway.conf
op copy /t/prefix/bin/../share/project-path-gateway/project-path-gateway.sh ./.tools/project-path-gateway/.ppg-tmp.4242.project-path-gateway.sh
op link ./.tools/project-path-gateway/.ppg-tmp.4242.project-path-gateway.sh ./.tools/project-path-gateway/project-path-gateway.sh
op remove ./.tools/project-path-gateway/.ppg-tmp.4242.project-path-gateway.sh
