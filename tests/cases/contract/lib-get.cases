# 공개 API 계약: project_path_gateway_get (기능 001 library_get_contract_test, contracts/library-api.md 4절)
target lib-session project_path_gateway
layer api
fs file /t/root/.tools/project-path-gateway/.project-path-gateway
fs file /t/root/.tools/project-path-gateway/project-path-gateway.conf
content APP_CONFIG=config/app.json

case get-argument-count
call project_path_gateway_init /t/root
call project_path_gateway_get
call project_path_gateway_get A B
status 2
err project-path-gateway: project_path_gateway_get: 인자는 KEY 1개여야 합니다
err project-path-gateway: project_path_gateway_get: 인자는 KEY 1개여야 합니다
op returned project_path_gateway_init 0
op returned project_path_gateway_get 2
op returned project_path_gateway_get 2

case get-not-initialized
call project_path_gateway_get APP_CONFIG
status 2
err project-path-gateway: project_path_gateway_get: 초기화되지 않았습니다. project_path_gateway_init을 먼저 호출하세요
op returned project_path_gateway_get 2

case get-unknown-key
call project_path_gateway_init /t/root
call project_path_gateway_get NOPE
status 2
err project-path-gateway: project_path_gateway_get: 등록되지 않은 키입니다: NOPE
op returned project_path_gateway_init 0
op returned project_path_gateway_get 2

case get-success-prints-absolute-path
call project_path_gateway_init /t/root
call project_path_gateway_get APP_CONFIG
status 0
out /t/root/config/app.json
op returned project_path_gateway_init 0
op returned project_path_gateway_get 0

case get-path-existence-is-not-checked
fs dir /t/root/config
call project_path_gateway_init /t/root
call project_path_gateway_get APP_CONFIG
status 0
out /t/root/config/app.json
op returned project_path_gateway_init 0
op returned project_path_gateway_get 0

case get-paths-are-joined-verbatim
fs file /t/root/.tools/project-path-gateway/project-path-gateway.conf
content SPACE=a b/c d
content KOREAN=한글/경로
content EQUAL=a=b
content DASH=-x
content DOT=./a
content TRAIL=dir/
content EMPTYSEG=a//b
call project_path_gateway_init /t/root
call project_path_gateway_get SPACE
call project_path_gateway_get KOREAN
call project_path_gateway_get EQUAL
call project_path_gateway_get DASH
call project_path_gateway_get DOT
call project_path_gateway_get TRAIL
call project_path_gateway_get EMPTYSEG
status 0
out /t/root/a b/c d
out /t/root/한글/경로
out /t/root/a=b
out /t/root/-x
out /t/root/./a
out /t/root/dir/
out /t/root/a//b
op returned project_path_gateway_init 0
op returned project_path_gateway_get 0
op returned project_path_gateway_get 0
op returned project_path_gateway_get 0
op returned project_path_gateway_get 0
op returned project_path_gateway_get 0
op returned project_path_gateway_get 0
op returned project_path_gateway_get 0

# 초기화 뒤 데이터 파일 변경·삭제, 루트 삭제 (기능 001 test_data_file_changes_after_init, test_root_deleted_after_init):
# 가상 파일 시스템은 call 사이에 바뀌지 않으므로, 초기화가 남긴 호출 셸 변수를 caller-var로 주고 바뀐 뒤의 파일 상태로 조회한다.
case get-after-init-reads-changed-data-file
caller-var PROJECT_PATH_GATEWAY_ROOT /t/changed
fs file /t/changed/.tools/project-path-gateway/.project-path-gateway
fs file /t/changed/.tools/project-path-gateway/project-path-gateway.conf
content APP_CONFIG=config/new.json
call project_path_gateway_get APP_CONFIG
status 0
out /t/changed/config/new.json
op returned project_path_gateway_get 0

case get-after-init-data-file-violation
caller-var PROJECT_PATH_GATEWAY_ROOT /t/changed
fs file /t/changed/.tools/project-path-gateway/.project-path-gateway
fs file /t/changed/.tools/project-path-gateway/project-path-gateway.conf
content bad line
call project_path_gateway_get APP_CONFIG
status 2
err project-path-gateway: /t/changed/.tools/project-path-gateway/project-path-gateway.conf:1: KEY=경로 형식이 아닙니다
op returned project_path_gateway_get 2

case get-after-init-data-file-deleted
caller-var PROJECT_PATH_GATEWAY_ROOT /t/changed
fs file /t/changed/.tools/project-path-gateway/.project-path-gateway
call project_path_gateway_get APP_CONFIG
status 2
err project-path-gateway: project_path_gateway_get: 데이터 파일을 읽을 수 없습니다: /t/changed/.tools/project-path-gateway/project-path-gateway.conf
op returned project_path_gateway_get 2

case get-after-init-root-deleted
caller-var PROJECT_PATH_GATEWAY_ROOT /t/deleted
call project_path_gateway_get APP_CONFIG
status 2
err project-path-gateway: project_path_gateway_get: 데이터 파일을 읽을 수 없습니다: /t/deleted/.tools/project-path-gateway/project-path-gateway.conf
op returned project_path_gateway_get 2

# 기능 005 보호 사례(US1): 리팩터링이 건드리는 레코드 경계. 경로의 TAB은 잘리지 않고, 앞부분이 같은 키는 정확히 일치하는 키만 찾는다.
case get-path-with-tab-is-kept
fs file /t/root/.tools/project-path-gateway/project-path-gateway.conf
content TABBED=a\tb/c
call project_path_gateway_init /t/root
call project_path_gateway_get TABBED
status 0
out /t/root/a\tb/c
op returned project_path_gateway_init 0
op returned project_path_gateway_get 0

case get-prefix-key-exact-match
fs file /t/root/.tools/project-path-gateway/project-path-gateway.conf
content DOCS_DIR=two
content DOC=one
call project_path_gateway_init /t/root
call project_path_gateway_get DOC
call project_path_gateway_get DOCS_DIR
status 0
out /t/root/one
out /t/root/two
op returned project_path_gateway_init 0
op returned project_path_gateway_get 0
op returned project_path_gateway_get 0
