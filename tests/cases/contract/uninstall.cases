# 공개 API 계약: 제거 스크립트 (기능 001 install_uninstall_test, contracts/install.md 2절, FR-088~FR-090)
target script-main uninstall.sh
layer api
unset-env PREFIX
self /repo/uninstall.sh
fs file /repo/uninstall.sh
fs file /t/prefix/share/project-path-gateway/project-path-gateway.sh
fs file /t/prefix/share/project-path-gateway/VERSION
fs file /t/prefix/share/project-path-gateway/install-manifest
content bin/project-path-gateway
content share/project-path-gateway/project-path-gateway.sh
content share/project-path-gateway/VERSION
content share/project-path-gateway/install-manifest

case uninstall-removes-installed-files-only
fs file /t/prefix/bin/project-path-gateway
fs file /t/prefix/bin/other-tool
arg --prefix
arg /t/prefix
status 0
out project-path-gateway: 제거 완료: /t/prefix
op remove /t/prefix/bin/project-path-gateway
op remove /t/prefix/share/project-path-gateway/project-path-gateway.sh
op remove /t/prefix/share/project-path-gateway/VERSION
op remove /t/prefix/share/project-path-gateway/install-manifest
op rmdir /t/prefix/share/project-path-gateway

case uninstall-skips-already-missing-file
fs dir /t/prefix/bin
fs file /t/prefix/bin/other-tool
arg --prefix
arg /t/prefix
status 0
out project-path-gateway: 제거 완료: /t/prefix
op remove /t/prefix/bin/project-path-gateway
op remove /t/prefix/share/project-path-gateway/project-path-gateway.sh
op remove /t/prefix/share/project-path-gateway/VERSION
op remove /t/prefix/share/project-path-gateway/install-manifest
op rmdir /t/prefix/share/project-path-gateway

case uninstall-default-prefix-uses-home
env HOME /t/home
fs file /t/home/.local/share/project-path-gateway/install-manifest
content bin/project-path-gateway
content share/project-path-gateway/install-manifest
status 0
out project-path-gateway: 제거 완료: /t/home/.local
op remove /t/home/.local/bin/project-path-gateway
op remove /t/home/.local/share/project-path-gateway/install-manifest
op rmdir /t/home/.local/share/project-path-gateway

case uninstall-without-manifest
fs dir /t/empty
arg --prefix
arg /t/empty
status 1
err project-path-gateway: 설치 기록이 없습니다: /t/empty

case uninstall-rejects-parent-entry
fs file /t/prefix/bin/project-path-gateway
fs file /t/victim
fs file /t/prefix/share/project-path-gateway/install-manifest
content bin/project-path-gateway
content ../victim
arg --prefix
arg /t/prefix
status 1
err project-path-gateway: 설치 목록에 .. 세그먼트가 있어 제거하지 않습니다: ../victim

case uninstall-rejects-absolute-entry
fs file /t/prefix/bin/project-path-gateway
fs file /t/prefix/share/project-path-gateway/install-manifest
content /abs
arg --prefix
arg /t/prefix
status 1
err project-path-gateway: 설치 목록에 절대경로가 있어 제거하지 않습니다: /abs

case uninstall-invalid-option
arg --bogus
status 2
err 사용법: sh uninstall.sh [--prefix DIR]

case uninstall-prefix-without-value
arg --prefix
status 2
err 사용법: sh uninstall.sh [--prefix DIR]

# 기능 006 FR-016: 1.1.0 설치 목록(스킬 줄 포함)으로 제거하면 SKILL.md도 지우고 공유 디렉터리가 빈 상태가 되어 사라진다.
# 제거 스크립트는 목록을 그대로 따르므로 코드가 바뀌지 않는다.
case uninstall-removes-skill-from-manifest
self /repo/uninstall.sh
fs file /t/p2/bin/project-path-gateway
fs file /t/p2/share/project-path-gateway/project-path-gateway.sh
fs file /t/p2/share/project-path-gateway/VERSION
fs file /t/p2/share/project-path-gateway/SKILL.md
fs file /t/p2/share/project-path-gateway/install-manifest
content bin/project-path-gateway
content share/project-path-gateway/project-path-gateway.sh
content share/project-path-gateway/VERSION
content share/project-path-gateway/SKILL.md
content share/project-path-gateway/install-manifest
arg --prefix
arg /t/p2
status 0
out project-path-gateway: 제거 완료: /t/p2
op remove /t/p2/bin/project-path-gateway
op remove /t/p2/share/project-path-gateway/project-path-gateway.sh
op remove /t/p2/share/project-path-gateway/VERSION
op remove /t/p2/share/project-path-gateway/SKILL.md
op remove /t/p2/share/project-path-gateway/install-manifest
op rmdir /t/p2/share/project-path-gateway

# 기능 006 경계 사례: 1.0.0 설치 목록(스킬 줄 없음)으로 제거하면 SKILL.md가 남아 공유 디렉터리는 지워지지 않는다.
case uninstall-old-manifest-leaves-skill-and-share-dir
fs file /t/prefix/bin/project-path-gateway
fs file /t/prefix/share/project-path-gateway/SKILL.md
arg --prefix
arg /t/prefix
status 0
out project-path-gateway: 제거 완료: /t/prefix
op remove /t/prefix/bin/project-path-gateway
op remove /t/prefix/share/project-path-gateway/project-path-gateway.sh
op remove /t/prefix/share/project-path-gateway/VERSION
op remove /t/prefix/share/project-path-gateway/install-manifest
op rmdir /t/prefix/share/project-path-gateway
