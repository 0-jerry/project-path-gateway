# 기능 005 보호 사례(US1): 경로의 TAB이 누락 보고에 그대로 나온다.
case verify-missing-path-with-tab-reported-verbatim
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content TABBED=a\tb
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 1
err project-path-gateway: 누락: TABBED=a\tb
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1

# 기능 006 US1·SC-001: 초기화 템플릿이 넣은 기본 항목 두 개만 있는 데이터 파일은 검증을 통과한다.
case verify-default-template-entries-pass
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content # project-path-gateway 데이터 파일
content #
content # 아래 두 항목은 초기화가 넣은 기본 항목입니다. 필요하지 않으면 지워도 됩니다.
content PPG_TOOL_DIR=.tools/project-path-gateway
content AGENT_SKILLS_DIR=.agents/skills
content #
content # 예:
content # SOURCES_ROOT=sources
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
fs dir /t/root/.agents/skills
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 0
out project-path-gateway: 검증 통과 2건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 0

# 기능 007 US4: 검증은 실제 종류까지 확인한다 (contracts/library-api.md 5절). 항목마다 누락 → 루트 밖 → 종류 순서로 한 줄만 보고한다
case verify-kind-all-match-counts-both-files
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content SRC=src
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
content CONF=config/app.json
fs dir /t/root/src
fs file /t/root/config/app.json
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 0
out project-path-gateway: 검증 통과 2건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 0

case verify-kind-dir-entry-points-to-file
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content SRC=src
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
fs file /t/root/src
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 1
err project-path-gateway: 종류 불일치: SRC=src (디렉터리가 아님)
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1

case verify-kind-file-entry-points-to-directory
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
content CONF=conf.d
fs dir /t/root/conf.d
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 1
err project-path-gateway: 종류 불일치: CONF=conf.d (일반 파일이 아님)
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1

case verify-kind-link-final-target-kind-matches
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content LINKED_DIR=dl
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
content LINKED_FILE=lf.txt
fs dir /t/root/real
fs file /t/root/real/target
fs link /t/root/dl real
fs link /t/root/lf.txt real/target
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 0
out project-path-gateway: 검증 통과 2건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 0

case verify-kind-link-final-target-kind-differs
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content LINKED_DIR=dl
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
fs file /t/root/real/target
fs link /t/root/dl real/target
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 1
err project-path-gateway: 종류 불일치: LINKED_DIR=dl (디렉터리가 아님)
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1

case verify-kind-outside-root-reports-outside-only
