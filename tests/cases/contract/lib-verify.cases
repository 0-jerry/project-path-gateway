# 공개 API 계약: project_path_gateway_verify (기능 001 library_verify_contract_test, verify_filesystem_test, contracts/library-api.md 5절)
# 검증은 변경 작업을 하지 않는다: ops changes 기대에 변경 기록이 없다.
target lib-session project_path_gateway
layer api
fs file /t/root/.tools/project-path-gateway/.project-path-gateway

case verify-argument-is-rejected
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
call project_path_gateway_init /t/root
call project_path_gateway_verify extra more
status 2
err project-path-gateway: project_path_gateway_verify: 인자는 0개 또는 REPORT_FILE 1개여야 합니다
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 2

case verify-not-initialized
call project_path_gateway_verify
status 2
err project-path-gateway: project_path_gateway_verify: 초기화되지 않았습니다. project_path_gateway_init을 먼저 호출하세요
op returned project_path_gateway_verify 2

case verify-data-file-errors-skip-entry-checks
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content MISSING=nope
content bad
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
call eval PROJECT_PATH_GATEWAY_ROOT=/t/root
call project_path_gateway_verify
status 2
err project-path-gateway: /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf:2: KEY=경로 형식이 아닙니다
op returned eval 0
op returned project_path_gateway_verify 2

case verify-missing-data-file-skips-entry-checks
fs dir /t/root/.tools/project-path-gateway
call eval PROJECT_PATH_GATEWAY_ROOT=/t/root
call project_path_gateway_verify
status 2
err project-path-gateway: project_path_gateway_verify: 데이터 파일을 읽을 수 없습니다: /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
op returned eval 0
op returned project_path_gateway_verify 2

case verify-all-entries-pass
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content A=a
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
content B=b/c.txt
fs dir /t/root/a
fs file /t/root/b/c.txt
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 0
out project-path-gateway: 검증 통과 2건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 0

case verify-zero-entries-pass
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content # 항목 없음
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 0
out project-path-gateway: 검증 통과 0건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 0

case verify-missing-entries-reported-in-order
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content B=gone_b
content KEEP=keep
content A=gone a
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
fs dir /t/root/keep
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 1
err project-path-gateway: 누락: B=gone_b
err project-path-gateway: 누락: A=gone a
err project-path-gateway: 검증 실패 2건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1

case verify-link-to-outside-directory
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content OUT=link
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
fs dir /t/outside
fs link /t/root/link /t/outside
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 1
err project-path-gateway: 루트 밖: OUT=link -> /t/outside
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1

case verify-link-to-outside-file-with-relative-target
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content OUT=d/link
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
fs file /t/outside/f
fs link /t/root/d/link ../../outside/f
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 1
err project-path-gateway: 루트 밖: OUT=d/link -> /t/outside/f
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1

case verify-broken-link-is-missing
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content BROKEN=link
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
fs link /t/root/link /t/root/nope
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 1
err project-path-gateway: 누락: BROKEN=link
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1

case verify-cyclic-link-is-missing
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content LOOP=a
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
fs link /t/root/a b
fs link /t/root/b a
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 1
err project-path-gateway: 누락: LOOP=a
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1

case verify-permission-denied-is-missing
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content LOCKED=locked/file
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
fs file /t/root/locked/file
fs deny /t/root/locked
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 1
err project-path-gateway: 누락: LOCKED=locked/file
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1

case verify-sibling-with-root-prefix-is-outside
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content SIB=sib
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
fs dir /t/root2/x
fs link /t/root/sib /t/root2/x
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 1
err project-path-gateway: 루트 밖: SIB=sib -> /t/root2/x
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1

case verify-file-link-chain-inside-root-passes
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
content CHAIN=l1.txt
fs file /t/root/real/target
fs link /t/root/l3 real/target
fs link /t/root/l2 l3
fs link /t/root/l1.txt /t/root/l2
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 0
out project-path-gateway: 검증 통과 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 0

case verify-directory-link-and-trailing-slash-pass
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content DIRLINK=dl
content TRAIL=dir/
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
content DOT=./dir/./f.txt
fs file /t/root/dir/f.txt
fs link /t/root/dl dir
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 0
out project-path-gateway: 검증 통과 3건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 0

case verify-missing-entry-is-not-checked-for-outside
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content BROKEN_OUT=link
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
fs link /t/root/link /nonexistent/ppg/target
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 1
err project-path-gateway: 누락: BROKEN_OUT=link
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1

case verify-paths-with-space-and-korean
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
content SPACE=a b/한글 파일.txt
fs file /t/root/a\sb/한글\s파일.txt
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 0
out project-path-gateway: 검증 통과 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 0

case verify-twice-does-not-change-filesystem
fs file /t/root/.tools/project-path-gateway/project-path-gateway.dirs.conf
content A=a
content MISSING=nope
fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
fs dir /t/root/a
call project_path_gateway_init /t/root
call project_path_gateway_verify
call project_path_gateway_verify
status 1
err project-path-gateway: 누락: MISSING=nope
err project-path-gateway: 검증 실패 1건
err project-path-gateway: 누락: MISSING=nope
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1
op returned project_path_gateway_verify 1

