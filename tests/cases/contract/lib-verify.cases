fs file /t/root/.tools/project-path-gateway/project-path-gateway.files.conf
content OUT=out.txt
fs dir /t/elsewhere
fs link /t/root/out.txt /t/elsewhere
call project_path_gateway_init /t/root
call project_path_gateway_verify
status 1
err project-path-gateway: 루트 밖: OUT=out.txt -> /t/elsewhere
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1

case verify-kind-missing-reports-missing-only
