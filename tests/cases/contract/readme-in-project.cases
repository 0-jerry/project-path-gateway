# 공개 API 계약: README 프로젝트 안 스크립트 사용 예 (기능 001 readme_examples_test_in_project_example, FR-070, FR-071)
# 사용 예 존재는 성공 사례로 대체한다(블록이 없으면 하니스 오류로 실패).
target readme-example in-project
layer api
self scripts/show-config.sh
fs file /t/my\sproject/.tool/project-path-gateway/.project-path-gateway
fs file /t/my\sproject/.tool/project-path-gateway/project-path-gateway.sh
fs file /t/my\sproject/.tool/project-path-gateway/project-path-gateway.conf
content APP_CONFIG=config/app.json
fs file /t/my\sproject/scripts/show-config.sh

case readme-in-project-example
fs file /t/my\sproject/config/app.json
cwd /t/my\sproject
status 0
out 설정 파일: /t/my project/config/app.json
op source /t/my\sproject/scripts/../.tool/project-path-gateway/project-path-gateway.sh
