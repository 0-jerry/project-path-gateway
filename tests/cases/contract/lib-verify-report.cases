# 공개 API 계약: project_path_gateway_verify [REPORT_FILE] (기능 003 contracts/library-api-verify.md, FR-001~FR-024)
# 리포트를 지정한 검증은 리포트 쓰기 작업(op write, op move)만 변경 기록으로 남긴다.
target lib-session project_path_gateway
layer api
fs file /t/root/.tool/project-path-gateway/.project-path-gateway
fs dir /out

# 인자 규칙과 기존 반환 2 조건 (FR-005, FR-022)
case verify-report-args-empty-string
fs file /t/root/.tool/project-path-gateway/project-path-gateway.conf
call project_path_gateway_init /t/root
call project_path_gateway_verify \e
status 2
err project-path-gateway: project_path_gateway_verify: 리포트 파일 경로가 비어 있습니다
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 2

case verify-report-args-not-initialized
fs file /out/report.txt
content old
call project_path_gateway_verify /out/report.txt
status 2
err project-path-gateway: project_path_gateway_verify: 초기화되지 않았습니다. project_path_gateway_init을 먼저 호출하세요
op returned project_path_gateway_verify 2

case verify-report-args-missing-data-file
fs dir /t/root/.tool/project-path-gateway
fs file /out/report.txt
content old
call eval PROJECT_PATH_GATEWAY_ROOT=/t/root
call project_path_gateway_verify /out/report.txt
status 2
err project-path-gateway: project_path_gateway_verify: 데이터 파일을 읽을 수 없습니다: /t/root/.tool/project-path-gateway/project-path-gateway.conf
op returned eval 0
op returned project_path_gateway_verify 2

case verify-report-args-data-file-violation
fs file /t/root/.tool/project-path-gateway/project-path-gateway.conf
content A=a
content bad
fs dir /t/root/a
call eval PROJECT_PATH_GATEWAY_ROOT=/t/root
call project_path_gateway_verify /out/report.txt
status 2
err project-path-gateway: /t/root/.tool/project-path-gateway/project-path-gateway.conf:2: KEY=경로 형식이 아닙니다
op returned eval 0
op returned project_path_gateway_verify 2

# US1: 실패 리포트 (FR-003, FR-010~FR-014, SC-001, SC-002)
# 짝 확인(SC-002): 각 사례는 같은 세션에서 리포트 미지정 검증 뒤 리포트 지정 검증을 호출해, 두 호출의 출력·반환이 같은지 한 사례로 본다.
# 짝(SC-002): 이 사례 안의 리포트 미지정 호출
case verify-report-fail-missing-two-of-three
fs file /t/root/.tool/project-path-gateway/project-path-gateway.conf
content A=a
content B=b
content C=c/d
fs dir /t/root/a
call project_path_gateway_init /t/root
call project_path_gateway_verify
call project_path_gateway_verify /out/report.txt
status 1
err project-path-gateway: 누락: B=b
err project-path-gateway: 누락: C=c/d
err project-path-gateway: 검증 실패 2건
err project-path-gateway: 누락: B=b
err project-path-gateway: 누락: C=c/d
err project-path-gateway: 검증 실패 2건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1
op write /out/.ppg-report.4242.report.txt project-path-gateway:\s누락:\sB=b\nproject-path-gateway:\s누락:\sC=c/d\nproject-path-gateway:\s검증\s실패\s2건\n
op move /out/.ppg-report.4242.report.txt /out/report.txt
op returned project_path_gateway_verify 1

# 짝(SC-002): 이 사례 안의 리포트 미지정 호출
case verify-report-fail-broken-link-and-outside-link
fs file /t/root/.tool/project-path-gateway/project-path-gateway.conf
content BROKEN=broken
content OUT=out
fs link /t/root/broken nowhere
fs dir /elsewhere
fs link /t/root/out /elsewhere
call project_path_gateway_init /t/root
call project_path_gateway_verify
call project_path_gateway_verify /out/report.txt
status 1
err project-path-gateway: 누락: BROKEN=broken
err project-path-gateway: 루트 밖: OUT=out -> /elsewhere
err project-path-gateway: 검증 실패 2건
err project-path-gateway: 누락: BROKEN=broken
err project-path-gateway: 루트 밖: OUT=out -> /elsewhere
err project-path-gateway: 검증 실패 2건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1
op write /out/.ppg-report.4242.report.txt project-path-gateway:\s누락:\sBROKEN=broken\nproject-path-gateway:\s루트\s밖:\sOUT=out\s->\s/elsewhere\nproject-path-gateway:\s검증\s실패\s2건\n
op move /out/.ppg-report.4242.report.txt /out/report.txt
op returned project_path_gateway_verify 1

# 짝(SC-002): 이 사례 안의 리포트 미지정 호출
case verify-report-fail-overwrites-previous-report
fs file /t/root/.tool/project-path-gateway/project-path-gateway.conf
content A=a
fs file /out/report.txt
content 이전 리포트
call project_path_gateway_init /t/root
call project_path_gateway_verify
call project_path_gateway_verify /out/report.txt
status 1
err project-path-gateway: 누락: A=a
err project-path-gateway: 검증 실패 1건
err project-path-gateway: 누락: A=a
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1
op write /out/.ppg-report.4242.report.txt project-path-gateway:\s누락:\sA=a\nproject-path-gateway:\s검증\s실패\s1건\n
op move /out/.ppg-report.4242.report.txt /out/report.txt
op returned project_path_gateway_verify 1

# 짝(SC-002): 이 사례 안의 리포트 미지정 호출
case verify-report-fail-report-path-with-space-and-korean
fs file /t/root/.tool/project-path-gateway/project-path-gateway.conf
content A=a
fs dir /out/결과\s폴더
call project_path_gateway_init /t/root
call project_path_gateway_verify
call project_path_gateway_verify /out/결과\s폴더/리포트\s1.txt
status 1
err project-path-gateway: 누락: A=a
err project-path-gateway: 검증 실패 1건
err project-path-gateway: 누락: A=a
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1
op write /out/결과\s폴더/.ppg-report.4242.리포트\s1.txt project-path-gateway:\s누락:\sA=a\nproject-path-gateway:\s검증\s실패\s1건\n
op move /out/결과\s폴더/.ppg-report.4242.리포트\s1.txt /out/결과\s폴더/리포트\s1.txt
op returned project_path_gateway_verify 1

# 짝(SC-002): 이 사례 안의 리포트 미지정 호출
case verify-report-fail-relative-report-path
cwd /out
fs file /t/root/.tool/project-path-gateway/project-path-gateway.conf
content A=a
call project_path_gateway_init /t/root
call project_path_gateway_verify
call project_path_gateway_verify report.txt
status 1
err project-path-gateway: 누락: A=a
err project-path-gateway: 검증 실패 1건
err project-path-gateway: 누락: A=a
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1
op write ./.ppg-report.4242.report.txt project-path-gateway:\s누락:\sA=a\nproject-path-gateway:\s검증\s실패\s1건\n
op move ./.ppg-report.4242.report.txt report.txt
op returned project_path_gateway_verify 1

# 짝(SC-002): 이 사례 안의 리포트 미지정 호출
case verify-report-fail-report-file-is-link-to-file
fs file /t/root/.tool/project-path-gateway/project-path-gateway.conf
content A=a
fs file /out/keep.txt
content 링크 대상
fs link /out/report.txt keep.txt
call project_path_gateway_init /t/root
call project_path_gateway_verify
call project_path_gateway_verify /out/report.txt
status 1
err project-path-gateway: 누락: A=a
err project-path-gateway: 검증 실패 1건
err project-path-gateway: 누락: A=a
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1
op write /out/.ppg-report.4242.report.txt project-path-gateway:\s누락:\sA=a\nproject-path-gateway:\s검증\s실패\s1건\n
op move /out/.ppg-report.4242.report.txt /out/report.txt
op returned project_path_gateway_verify 1

# 짝(SC-002): 이 사례 안의 리포트 미지정 호출
case verify-report-fail-key-and-path-with-space-equal-korean
fs file /t/root/.tool/project-path-gateway/project-path-gateway.conf
content SP_KEY=a b=c/한글 경로
call project_path_gateway_init /t/root
call project_path_gateway_verify
call project_path_gateway_verify /out/report.txt
status 1
err project-path-gateway: 누락: SP_KEY=a b=c/한글 경로
err project-path-gateway: 검증 실패 1건
err project-path-gateway: 누락: SP_KEY=a b=c/한글 경로
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1
op write /out/.ppg-report.4242.report.txt project-path-gateway:\s누락:\sSP_KEY=a\sb=c/한글\s경로\nproject-path-gateway:\s검증\s실패\s1건\n
op move /out/.ppg-report.4242.report.txt /out/report.txt
op returned project_path_gateway_verify 1

# 짝(SC-002): 이 사례 안의 리포트 미지정 호출
case verify-report-fail-report-at-registered-path
fs file /t/root/.tool/project-path-gateway/project-path-gateway.conf
content REPORT=report.txt
call project_path_gateway_init /t/root
call project_path_gateway_verify
call project_path_gateway_verify /t/root/report.txt
status 1
err project-path-gateway: 누락: REPORT=report.txt
err project-path-gateway: 검증 실패 1건
err project-path-gateway: 누락: REPORT=report.txt
err project-path-gateway: 검증 실패 1건
op returned project_path_gateway_init 0
op returned project_path_gateway_verify 1
op write /t/root/.ppg-report.4242.report.txt project-path-gateway:\s누락:\sREPORT=report.txt\nproject-path-gateway:\s검증\s실패\s1건\n
op move /t/root/.ppg-report.4242.report.txt /t/root/report.txt
op returned project_path_gateway_verify 1

# 짝(SC-002): 이 사례 안의 리포트 미지정 호출
