# 공개 API 계약: 설치 스크립트 (기능 001 install_uninstall_test, contracts/install.md 1절, FR-088~FR-090)
# 저장소 복사본을 /repo에 두고, 실행 환경의 PATH·PREFIX가 결과를 바꾸지 않도록 머리말에서 고정한다.
target script-main install.sh
layer api
env PATH /usr/bin:/bin
unset-env PREFIX
self /repo/install.sh
fs file /repo/install.sh
fs file /repo/bin/project-path-gateway
content # bin
fs file /repo/lib/project-path-gateway.sh
content # lib
fs file /repo/VERSION
content 0.1.0

case install-default-prefix-uses-home
env HOME /t/home
fs dir /t/home
status 0
out project-path-gateway: 설치 완료: /t/home/.local (버전 0.1.0)
out project-path-gateway: /t/home/.local/bin가 PATH에 없습니다. 셸 설정 파일에 다음 줄을 추가하세요:
out   export PATH="/t/home/.local/bin:$PATH"
op mkdir-p /t/home/.local/bin
op mkdir-p /t/home/.local/share/project-path-gateway
op copy /repo/bin/project-path-gateway /t/home/.local/bin/project-path-gateway.ppg-install.4242
op chmod 755 /t/home/.local/bin/project-path-gateway.ppg-install.4242
op move /t/home/.local/bin/project-path-gateway.ppg-install.4242 /t/home/.local/bin/project-path-gateway
op copy /repo/lib/project-path-gateway.sh /t/home/.local/share/project-path-gateway/project-path-gateway.sh.ppg-install.4242
op chmod 644 /t/home/.local/share/project-path-gateway/project-path-gateway.sh.ppg-install.4242
op move /t/home/.local/share/project-path-gateway/project-path-gateway.sh.ppg-install.4242 /t/home/.local/share/project-path-gateway/project-path-gateway.sh
op copy /repo/VERSION /t/home/.local/share/project-path-gateway/VERSION.ppg-install.4242
op chmod 644 /t/home/.local/share/project-path-gateway/VERSION.ppg-install.4242
op move /t/home/.local/share/project-path-gateway/VERSION.ppg-install.4242 /t/home/.local/share/project-path-gateway/VERSION
op write /t/home/.local/share/project-path-gateway/install-manifest.ppg-manifest.4242 bin/project-path-gateway\nshare/project-path-gateway/project-path-gateway.sh\nshare/project-path-gateway/VERSION\nshare/project-path-gateway/install-manifest\n
op copy /t/home/.local/share/project-path-gateway/install-manifest.ppg-manifest.4242 /t/home/.local/share/project-path-gateway/install-manifest.ppg-install.4242
op chmod 644 /t/home/.local/share/project-path-gateway/install-manifest.ppg-install.4242
op move /t/home/.local/share/project-path-gateway/install-manifest.ppg-install.4242 /t/home/.local/share/project-path-gateway/install-manifest
op remove /t/home/.local/share/project-path-gateway/install-manifest.ppg-manifest.4242

case install-prefix-option-and-files
arg --prefix
arg /t/prefix
status 0
out project-path-gateway: 설치 완료: /t/prefix (버전 0.1.0)
out project-path-gateway: /t/prefix/bin가 PATH에 없습니다. 셸 설정 파일에 다음 줄을 추가하세요:
