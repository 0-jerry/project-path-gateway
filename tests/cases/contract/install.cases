case install-invalid-option
arg --bogus
status 2
err 사용법: sh install.sh [--prefix DIR]

case install-prefix-without-value
arg --prefix
status 2
err 사용법: sh install.sh [--prefix DIR]

case install-write-failure
fs dir /t/locked
fs readonly /t/locked
arg --prefix
arg /t/locked/prefix
status 1
err project-path-gateway: 설치 실패: /t/locked/prefix/bin
op mkdir-p /t/locked/prefix/bin

case install-missing-version-file
fs dir /repo/VERSION
arg --prefix
arg /t/prefix
status 1
err project-path-gateway: 설치 실패: /repo/VERSION
