# 공개 API 계약: README 프로젝트 밖 스크립트 사용 예 (기능 001 readme_examples_test_outside_project_example, FR-070, FR-071)
target readme-example outside-project
layer api
self deploy.sh
fs file /t/my\sproject/.tools/project-path-gateway/.project-path-gateway
fs file /t/my\sproject/.tools/project-path-gateway/project-path-gateway.sh
fs file /t/my\sproject/.tools/project-path-gateway/project-path-gateway.conf
content APP_CONFIG=config/app.json
fs file /t/elsewhere/deploy.sh

case readme-outside-project-example
fs file /t/my\sproject/config/app.json
cwd /t/elsewhere
call /t/my\sproject
status 0
out /t/my project/config/app.json
op source /t/my\sproject/.tools/project-path-gateway/project-path-gateway.sh
